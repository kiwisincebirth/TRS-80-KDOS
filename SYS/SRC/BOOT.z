;;;
;;; BOOT.SYS - Like Boot Block on Floppy Disk
;;; (The main loader for MDOS)
;;;
;;; FreHD Like - SYS0.SYS - ROM LOADER
;;;
;;; These 256 bytes are the code which is initially loaded and starts
;;; the load of the actual mini DOS.
;;;
;;; This code tries to open "/SYS/SYS0x.SYS" on the SD-card.
;;; and will execute this code once loaded
;;;
;;; This is loaded and executed from Level 2 ROM if either:
;;;	* A Floppy Disk boot block will load this at $4200
;;;	    - In which case the code relocates itself to $5200
;;;    	* Fre HD Autoboot Rom will Load FREHD.ROM
;;;	    - FREHD.ROM will load this directly to $5200
;;;
;;; If loaded from floppy disk boot the code will automatically
;;; be relocated and executed from $5200
;;;

; ======================================================================
import	constants.z
; ======================================================================
;
	ORG	BOOTSYSLOC
;
; ----------------------------------------------------------------------
; handle relation of code up to $5200 is was loaded by floppy
; disk bootstrap at location $4200
; ----------------------------------------------------------------------
	call	_WHERE		; ($000B) - get PC into HL
	;			; HL has address of this next instruction
	ld	a,h		; MSB of address this code is running in.
	cp	$ / $100	; compare MSB with correct Code Page
	jr	z,START		; code already located, start as normal
	;
RELOCATE
	ld	l,0		; HL -> now has (where loaded) page address
	ld	de,BOOTSYSLOC	; target address, where code should execute from
	ld	bc,$100		; 256 bytes to move
	ldir			; transfer
	;
RELOADED:
	jp	START		; Explicity - Start the code - Correct Location
;
; ----------------------------------------------------------------------
; Now we need to
; ----------------------------------------------------------------------
START:
	; Detection of warm start
	ld	hl,KBROWCLR	; location of saved value
	ld	a,(14400)	; CLEAR Keyboard Row value
	;
	;ld	b,(hl)		; get saved val from last boot.
	;cp	b		; compare values
	;jp	z,@EXIT		; Currently Disabled, as $4000 - 405C wipd out
	;
	ld	(hl),a		; not warm boot remember it for next time.
	;
	; Detection of Advancded PICO hardware
	;
	; Potentially simplify this code, just read and check STATUS bit,
	; or new File-Id register (write read back), or a new command
	;
	ld	a,GETVER	; version information from FreHD
	out	(COMMAND2),a
	call	fhdwait		; ignoring result
	;
	ld	c, DATA2	; data port
	in	a,(c)		; read / skip over first byte
	in	a,(c)		; read / skip over second byte
	;
	in	d,(c)		; first half of version stamp - byte 3
	in	a,(c)		; second half of version stamp - byte 4
	xor	d		; xor them together -> $FF if Enhanced Pico
	inc	a		; $00 Z if advanced PICO hardware
	;
	ld	de,fnamef	; Default to FreHD Minimal /SYS0.SYS
	ld	b,$10		; length of 16 bytes
	;
	jr	nz,START1	; NZ If NOT Advanced Pico, skip over
	;
	; CLEAR KEY - Detection.
	ld	a,(14400)	; CLEAR Keyboard Row
	and	2		; CLEAR KEY Pressed
	jr	NZ, START1	; Then Use Traditional, not Paged
	;
	ld	de,fnamep	; Set advanced Pico /SYSP.SYS

START1:
	call	file_loader	; load the file
	;
	jp	nz,INIT2	; if FAILED init L2 BASIC
	;
	jp	(hl)		; jump to SYS0.SYS
	;
;;;
;;; FreHD file loader
;;;
;;; Input:
;;; - DE : pointer to filename
;;; - B  : filename length
;;;
;;; Return:
;;; - Z  : no error. HL contains transfer address
;;; - NZ : error occurred, file not or partially loaded
;;;
file_loader:
	ld	hl,0			; save SP in IX
	add	hl,sp
	push	hl
	pop	ix

	ex	de,hl
	ld	a,OPENFILE		; open file command
	out	(COMMAND2),a
	;
	ld	a,b			; Size Computation
	inc	a			; +1 for options
	inc	a			; +1 for null-terminator
	out	(SIZE2),a
	ld	c,DATA2
	ld	a,FA_OPEN_EXIST|FA_READ
	out	(c),a			; send option
	otir				; send filename
	xor	a			; send null-terminator
	out	(c),a
	;
	call	fhdwait
	ret	nz			; error, return

	ld	c,0FFh			; counter
load:
	call	getbyte			; get type code
	dec	a
	jr	nz,load3		; bypass if not type 1
	call	getaddr			; get address
load2:	call	getbyte
	ld	(hl),a			; save that byte
	inc	hl
	djnz	load2
	jr	load
;
load3:	dec	a			; test if type 2 (TRADDR)
	jr	z,load5			; yes
	call	getbyte			; assume comment
	ld	b,a			; get comment length
load4:	call	getbyte
	djnz	load4			; read and ignore
	jr	load
;
load5:
	call	getaddr			; get transfer address
	ld	a,CLOSEFILE		; close file
	out	(COMMAND2),a
	call	fhdwait
	xor	a			; set Z for success !
	ret
;
getaddr
	call	getbyte			; get block length
	ld	b,a
	call	getbyte			; get low-order load addr
	ld	l,a
	dec	b			; adjust length
	call	getbyte			; get high-order load addr
	ld	h,a
	dec	b			; adjust length
	ret
;
getbyte
	inc	c			; i++
	jr	nz,getbyte1		; every 256 bytes, need another chunk
	call	getchunk
getbyte1:
	in	a,(DATA2)		; get a byte
	ret
;
getchunk
	xor	a			; request 256 bytes
	out	(SIZE2),a
	ld	a,READFILE
	out	(COMMAND2),a
	call	fhdwait
	jr	nz,geterror
	in	a,(STATUS)		; DRQ set means we got something
	and	08h
	ret	nz			; return if ok !
					; fall through to error
geterror:
	ld	a,CLOSEFILE		; close file
	out	(COMMAND2),a
	call	fhdwait
	ld	sp,ix
	inc	a			; set NZ (wait returns A == 0 or 1)
	ret				; return

fhdwait:
	ex 	(sp),hl			; small delay to
	ex 	(sp),hl			; settle the controller
fhdwait1:
	in 	a, (STATUS)
	rlca
	jr 	c, fhdwait1
	in 	a, (STATUS)		; read status again
	and 	01h			; nz = error
	ret
;
; ----------------------------------------------------------------------
	; The file name is located on a 16 byte page boundary,
	; after all code to make it easy to change in C code
	; FILL to end of REGION
	FREE_BOOT	EQU	BOOTSYSLOC + $E0 - $
	assert	$ <= BOOTSYSLOC + $E0
	DC	FREE_BOOT,0
; ----------------------------------------------------------------------
;
	assert $ = BOOTSYSLOC + $E0
fnamef	db	"/SYS/SYS0.SYS",0,0,0		; FRED file name
	;
	assert $ = BOOTSYSLOC + $F0
fnamep	db	"/SYS/SYSP.SYS",0,0,0		; PICO file name
;
	assert $ = BOOTSYSLOC + $100
;
	END	START		; START is the normal entry location
				; If loaded as FDC boot block, then first byte
