; ======================================================================
;       	KDOS
;	based on TRSDOS, LDOS, and NEWDOS/80 for Model 1
;
;     BASIC AMPersand &Hxx &Oxxx Disk Basic extension
;
;     Source Code Created By : kiwisincebirth - 2026
;     [https://github.com/kiwisincebirth/TRS-80]
;
; ======================================================================
;     NOTE: this code has been formatted with 8 spaces per tab
; ----------------------------------------------------------------------
;
import	constants.z
;
; ======================================================================
;
; Set as Jump, we do NOT have a RET Semantic happening.
; there are quite a few escapes to OV err, etc
;
VIRTUAL_PAGE ampersand, PAGE_AMPERSAND
;
; ======================================================================
;
; Original Source from TRSDOS 2.3, See
; https://www.trs-80.com/sub-disassem-dos-td23-basic-cmd.htm
;
_5913
   ld	de,$0000         ; 5913:
   rst	$0010            ; 5916:
   cp	$4f              ; 5917:
   jr	z,_5947        ; 5919:
   cp	$48              ; 591b:
   jr	nz,_5946       ; 591d:
   ld	b,$05            ; 591f:
_5921
   inc	hl               ; 5921:
   ld	a,(hl)           ; 5922:
   call	$1e3e            ; 5923:
   ex	de,hl            ; 5926:
   jr	nc,_5933         ; 5927:
   cp	$3a              ; 5929:
   jr	nc,_5964         ; 592b:
   sub	$30              ; 592d:
   jr	c,_5964          ; 592f:
   jr	_5939            ; 5931:
_5933
   cp	$47              ; 5933:
   jr	nc,_5964         ; 5935:
   sub	$37              ; 5937:
_5939
   add	hl,hl            ; 5939:
_593a
   add	hl,hl            ; 593a:
   add	hl,hl            ; 593b:
   add	hl,hl            ; 593c:
   or	l                ; 593d:
   ld	l,a              ; 593e:
   dec	b                ; 593f:
   jp	z,$07b2          ; 5940:
   ex	de,hl            ; 5943:
   jr	_5921            ; 5944:
_5946
   dec	hl               ; 5946:
_5947
   rst	$0010            ; 5947:
   ex	de,hl            ; 5948:
   jr	nc,_5964         ; 5949:
   cp	$38              ; 594b:
   jp	nc,$1997         ; 594d:
   ld	bc,$07b2         ; 5950: Return address OV ERR
   push	bc               ; 5953: pushed for rets below
   add	hl,hl            ; 5954:
   ret	c                ; 5955: So effective JP
   add	hl,hl            ; 5956:
   ret	c                ; 5957: So effective JP
   add	hl,hl            ; 5958:
   ret	c                ; 5959: So effective JP
   pop	bc               ; 595a: Clear the ?OV ERROR address
   ld	b,$00            ; 595b:
   sub	$30              ; 595d:
   ld	c,a              ; 595f:
   add	hl,bc            ; 5960:
   ex	de,hl            ; 5961:
   jr	_5947          ; 5962:
_5964
   call	$0a9a            ; 5964:
   ex	de,hl            ; 5967:
   ret                   ; 5968: An actual RET

;
; ======================================================================
; End of Paged Routine
; ======================================================================
;
VIRTUAL_END
;
; ======================================================================
; DOS ENTRY VECTOR
; ======================================================================
;
	ORG	$4194
	jp	ampersand
;
