; ======================================================================
;       	KDOS
;	based on TRSDOS, LDOS, and NEWDOS/80 for Model 1
;
;     SYSP (Paged SYS0) - including all additional modules
;	loaded into paged RAM
;
;     Source Code Created By : kiwisincebirth - 2026
;     [https://github.com/kiwisincebirth/TRS-80]
;
; ======================================================================
;     NOTE: this code has been formatted with 8 spaces per tab
; ----------------------------------------------------------------------
;
; We are compiling the Pico Enhanced ROM File
@D_PICOENHANCED	EQU	1
;
; Constants
import constants.z
;
; ----------------------------------------------------------------------
; Core SYS 0 ($4200 - $4500)
; ----------------------------------------------------------------------
include sys0.z

; ----------------------------------------------------------------------
; Include the overlays within
; Defined Virtual RAM Pages
; ----------------------------------------------------------------------

; Basic Load Save commands
; These are functions that JP back to dos
VIRTUAL_PAGE _basic_overb, PAGE_OVERLAYB
include	overlayb.z
VIRTUAL_END

; Command Processor Overlay
; it is a terminal service, no RETURN
VIRTUAL_PAGE _basic_overc, PAGE_OVERLAYC
include	overlayc.z
VIRTUAL_END

; DIR Command
; No ret from this, back to dos
VIRTUAL_PAGE _basic_overd, PAGE_OVERLAYD
include	overlayd.z
VIRTUAL_END

; Error Reporting for DOS
; These are routines that can either
; return or Jump out to Dos
VIRTUAL_PAGE _basic_overe, PAGE_OVERLAYE
include	overlaye.z
VIRTUAL_END

; DOS Routines for DISK File Open/Close Access
; These are DOS routines that ALL return to caller
VIRTUAL_ROUTINE _basic_overf, PAGE_OVERLAYF
include	overlayf.z
VIRTUAL_END

; DOS Routines for DISK File R/W Access
; These are DOS routines that ALL return to caller
VIRTUAL_ROUTINE _basic_overg, PAGE_OVERLAYG
include	overlayg.z
VIRTUAL_END

; Help Command Text
; Loader Command has a Jump to DOS
VIRTUAL_PAGE _basic_overh, PAGE_OVERLAYH
include	overlayh.z
VIRTUAL_END

; CMD Loader and Runner
; For Loader API Call we have a RET path
; Loader Command has a Jump to DOS
VIRTUAL_PAGE _basic_overl, PAGE_OVERLAYL
include	overlayl.z
VIRTUAL_END

; File System Command
; No ret from this, back to dos
VIRTUAL_PAGE _basic_overs, PAGE_OVERLAYO
include	overlayo.z
VIRTUAL_END

; ----------------------------------------------------------------------
; Misc Code Extensions
; ----------------------------------------------------------------------
;
include	INTERRUPT.z		; Interrupt Handler
include BASIC-HELP.z		; Used by Help Overlay
;
; ----------------------------------------------------------------------
; BASIC Extensions - Non Disk Functions
; ----------------------------------------------------------------------
;
include	BASIC-CVI.z		; $4152 ... $415E
include	BASIC-DEFFN.z		; $4155
include	BASIC-DEFINE.z		; $415B
include	BASIC-MKI.z		; $416A ... $4170
include	BASIC-TIME.z		; $4176
include	BASIC-AMP.z		; $4194
include	BASIC-INSTR.z		; $419D
include	BASIC-LINE.z		; $41A3
;
; ----------------------------------------------------------------------
; DOS Exits
; ----------------------------------------------------------------------
;
include BASIC-ERROR.z		; $41A6
include BASIC-USR.z		; $41A9
include	BASIC-MID.z		; $41D9
;
; ----------------------------------------------------------------------
; Pico Scratch Memory ($3600 - $37DF)
; ----------------------------------------------------------------------
include PICO-WORK.z
;
; ----------------------------------------------------------------------
; Startup Code Block ($3600 - $37DF)
; ----------------------------------------------------------------------
include startup.z
;
; ======================================================================
	END	STARTUP
; ======================================================================
