; ======================================================================
;       	KDOS
;	based on TRSDOS, LDOS, and NEWDOS/80 for Model 1
;
;     Working Memory in PICO Scratch RAM (3400-37EF)
;
;     Source Code Created By : kiwisincebirth - 2026
;     [https://github.com/kiwisincebirth/TRS-80]
;
; ======================================================================
;     NOTE: this code has been formatted with 8 spaces per tab
; ----------------------------------------------------------------------
;
import	constants.z
;
; ======================================================================
; Scratch RAM - Unpaged (3600h - 37DFh)
; ======================================================================
;
	ORG	PICOSCRATCH
;
; ======================================================================
; JUMP TABLE
; ======================================================================
;
pico_loader:
	jp	_ploader		; Redirected from SCR_LOADOADER
;
;
; ======================================================================

; ----------------------------------------------------------------------
;
; File loader
;
; **** ON a PICo this code has to be in the SCRATCH RAM
; **** Since the Loader could load functions into Paged RAM
;
; Input:
; - DE : pointer to filename
; - B  : filename length
;
; Return:
; - Z  : no error ;    HL : contains transfer address
; - NZ : error occurred, file not or partially loaded
;
_ploader:
; todo replace the code below with Command to PICO to start virtual load, and command to restore prior state
	ld	a,(PICOPAGENUM)		; get current virtual page number
	ld	(_pload1+1),a		; save it into instruction below
	call	_loader
	push	af
_pload1:
	ld	a,0			; self modifying saved page number
	ld	(PICOPAGENUM),a		; set the virtual page number
	pop	af
	ret
;
_loader:
	ld	c,FA_OPEN_EXIST|FA_READ
	call	api_OPEN	; open file command
	ret	nz		; error, then return
	;
_load:	call	api_READBYTE	; get type code
	jr	nz,_load9	; no byte so assume finished and return
	;
	dec	a
	jr	nz,_load2	; bypass if not type 1
	;
_load1:	call	_getadr		; Type 1 get address; HL Addr and B Size
	ret	nz
	;
_load1a: call	api_READBYTE
	ret	nz
	ld	(hl),a		; save that byte
	inc	hl
	djnz	_load1a
	jr	_load
	;
_load2:	dec	a		; test if type 2 (TRADDR)
	jr	z,_load8		; yes consume transfer address
	;
	call	api_READBYTE	; Type 3 and above: assume comment
	ld	b,a		; get comment length
_load2a:
	call	api_READBYTE	; read comment character
	ret	nz
	djnz	_load2a		; read and ignore
	jr	_load
	;
_load8:	call	_getadr		; get transfer address
	ret	nz
	;
_load9:	call	api_CLOSE
	xor	a		; set Z for success !
	ret
	;
_getadr:
	call	api_READBYTE	; get block length
	ret	nz
	ld	b,a		; get length and
	dec	b		; adjust length
	dec	b		; adjust length
	call	api_READBYTE	; get low-order load addr
	ret	nz
	ld	l,a
	call	api_READBYTE	; get high-order load addr
	ret	nz
	ld	h,a		; address into HL
	xor	a		; success
	ret
;
; ----------------------------------------------------------------------
;
FREE_PICOWORK	EQU	PICOSCRDUSR - $
	assert	FREE_PICOWORK > 0
;
; ----------------------------------------------------------------------
; Everything from here down is top down and fixed by address
; ----------------------------------------------------------------------
;
	; Hold Jump address for USR 0 - 9 Functional calls
	;
	ORG	PICOSCRDUSR
	DEFW	$1E4A		; Jump address of FC Error
	DEFW	$1E4A
	DEFW	$1E4A
	DEFW	$1E4A
	DEFW	$1E4A
	DEFW	$1E4A
	DEFW	$1E4A
	DEFW	$1E4A
	DEFW	$1E4A
	DEFW	$1E4A
