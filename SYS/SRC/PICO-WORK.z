; ======================================================================
;       	MINI DOS
;	based on TRSDOS, LDOS, and NEWDOS/80 for Model 1
;
;     Working Memory in PICO Scratch RAM
;
;     Source Code Created By : kiwisincebirth - 2026
;     [https://github.com/kiwisincebirth/TRS-80]
;
; ======================================================================
;     NOTE: this code has been formatted with 8 spaces per tab
; ----------------------------------------------------------------------
;
import	constants.z
;
; ======================================================================
; Scratch RAM - Unpaged (3600h - 37DFh)
; ======================================================================
;
	ORG	PICOSCRATCH
;
; ======================================================================
; JUMP TABLE
; ======================================================================
;
pico_loader:
	jp	_ploader		; Redirected from SCR_LOADOADER
	jp	_isr_service		; Redirected from SCR_INT_SERV
;F
; ======================================================================

; ----------------------------------------------------------------------
;;;
;;; FreHD file loader
;;;
;;; **** ON a PICo this code has to be in the SCRATCH RAM
;;; **** Since the Loader could load functions into Paged RAM
;;;
;;; Input:
;;; - DE : pointer to filename
;;; - B  : filename length
;;;
;;; Return:
;;; - Z  : no error ;    HL : contains transfer address
;;; - NZ : error occurred, file not or partially loaded
;;;
_ploader:
	ld	a,(PICOPAGENUM)		; get current virtual page number
	ld	(_pload1+1),a		; save it into instruction below
	call	_loader
	push	af
_pload1:
	ld	a,0			; self modifying saved page number
	ld	(PICOPAGENUM),a		; set the virtual page number
	pop	af
	ret
;
_loader:
	ld	c,FA_OPEN_EXIST|FA_READ
	call	fhd_OPEN	; open file command
	ret	nz		; error, then return
	;
_load:	call	fhd_READBYTE	; get type code
	jr	nz,_load9	; no byte so assume finished and return
	;
	dec	a
	jr	nz,_load2	; bypass if not type 1
	;
_load1:	call	_getadr		; Type 1 get address; HL Addr and B Size
	ret	nz
	;
_load1a:	call	fhd_READBYTE
	ret	nz
	ld	(hl),a		; save that byte
	inc	hl
	djnz	_load1a
	jr	_load
	;
_load2:	dec	a		; test if type 2 (TRADDR)
	jr	z,_load8		; yes consume transfer address
	;
	call	fhd_READBYTE	; Type 3 and above: assume comment
	ld	b,a		; get comment length
_load2a:
	call	fhd_READBYTE	; read comment character
	ret	nz
	djnz	_load2a		; read and ignore
	jr	_load
	;
_load8:	call	_getadr		; get transfer address
	ret	nz
	;
_load9:	call	fhd_CLOSE
	xor	a		; set Z for success !
	ret
	;
_getadr:
	call	fhd_READBYTE	; get block length
	ret	nz
	ld	b,a		; get length and
	dec	b		; adjust length
	dec	b		; adjust length
	call	fhd_READBYTE	; get low-order load addr
	ret	nz
	ld	l,a
	call	fhd_READBYTE	; get high-order load addr
	ret	nz
	ld	h,a		; address into HL
	xor	a		; success
	ret

; ----------------------------------------------------------------------
; ----------------------------------------------------------------------
; ----------------------------------------------------------------------
;;;
;;; Interrupt Service Routine
;;; todo consider moving this to virtual ram.
;;;
_isr_service
	;
	push	hl
	push	de
	push	bc		; Main Interrupt Handler
	;
	ld	hl,TICKCNT	; timer tick
	inc	(hl)		; increment the timer tick
	;
	call	_trs80_time	; RTC Clock update
	;

_isr_exit:
	pop	bc
	pop	de
	pop	hl
	;
	ret
;
; ----------------------------------------------------------------------
; RTC Clock Interrupt Routine
; ----------------------------------------------------------------------
;
_trs80_time:
	ld	hl,_counter	; counter tick storage
	dec	(hl)		; dec the counter
	ret	nz		; not ready so return
	;
	ld	(hl),40		; reset countdown from 40 (HZ)
	;
; Now advance the clock by 1 second (will rollover)
; TRSDOS Routine to advance the time
; Original Code from TRS-DOS 2.3 See
; https://www.trs-80.com/sub-disassem-dos-td23-sys-0.htm
	;
	ld	b,$03            ; 45ba:
	ld	hl,XTIME         ; 45bc:
	ld	de,_cal_limit_45ef  ; 45bf:
_count_inc:
	inc	(hl)             ; 45c2:
	ld	a,(de)           ; 45c3:
	sub	(hl)             ; 45c4:
	ret	nz               ; 45c5:
	ld	(hl),a           ; 45c6:
	inc	l                ; 45c7:
	inc	e                ; 45c8:
	djnz	_count_inc       ; 45c9:
	inc	l                ; 45cb:
	inc	(hl)             ; 45cc:
	inc	l                ; 45cd:
	ld	a,(hl)           ; 45ce:
	dec	l                ; 45cf:
	dec	a                ; 45d0:
	add	a,e              ; 45d1:
	ld	e,a              ; 45d2:
	ld	a,(de)           ; 45d3:
	cp	(hl)             ; 45d4:
	ret	nc               ; 45d5:
	ld	a,(hl)           ; 45d6:
	cp	$1e              ; 45d7:
	jr	nc,_reset_dom    ; 45d9:
	dec	l                ; 45db:
	ld	a,(hl)           ; 45dc:
	inc	l                ; 45dd:
	and	$03              ; 45de:
	ret	z                ; 45e0:
_reset_dom:
	ld	(hl),$01         ; 45e1:
	inc	l                ; 45e3:
	inc	(hl)             ; 45e4:
	ld	a,(hl)           ; 45e5:
	sub	$0d              ; 45e6:
	ret	c                ; 45e8:
	ld	(hl),$01         ; 45e9:
	dec	l                ; 45eb:
	dec	l                ; 45ec:
	inc	(hl)             ; 45ed:
	ret                      ; 45ee:
;
_counter
	DB	40		; starting counter
;
_cal_limit_45ef:
	DB	3CH 	; Maximum number of 60 for SECONDS
	DB	3CH	; Maximum number of 60 for MINUTES
	DB	18H	; Maximum number of 24 for HOURS
	DB	1FH	; Maximum number of 31 for JANUARY
	DB	1CH	; Maximum number of 28 for FEBRUARY
	DB	1FH	; Maximum number of 31 for MARCH
	DB	1EH	; Maximum number of 30 for APRIL
	DB	1FH	; Maximum number of 31 for MAY
	DB	1EH	; Maximum number of 30 for JUNE
	DB	1FH	; Maximum number of 31 for JULY
	DB	1FH	; Maximum number of 31 for AUGUST
	DB	1EH	; Maximum number of 30 for SEPTEMBER
	DB	1FH	; Maximum number of 31 for OCTOBER
	DB	1EH	; Maximum number of 30 for NOVEMBER
	DB	1FH 	; Maximum number of 31 for DECEMBER
;
; ----------------------------------------------------------------------
;
FREE_PICOWORK	EQU	PICOSCRDUSR - $
	assert	FREE_PICOWORK > 0
;
; ----------------------------------------------------------------------
; Everything from here down is top down and fixed by address
; ----------------------------------------------------------------------
;
	; Hold Jump address for USR 0 - 9 Functional calls
	;
	ORG	PICOSCRDUSR
	DEFW	$1E4A		; Jump address of FC Error
	DEFW	$1E4A
	DEFW	$1E4A
	DEFW	$1E4A
	DEFW	$1E4A
	DEFW	$1E4A
	DEFW	$1E4A
	DEFW	$1E4A
	DEFW	$1E4A
	DEFW	$1E4A
