
; ------------------------------
; BASIC ERROR Reporting extension
; Original Source from TRSDOS 2.3
; SEE
; https://www.trs-80.com/sub-disassem-dos-td23-basic-cmd.htm
; ------------------------------
;
import	constants.z
;
; ------------------------------
; CODE STARTS HERE
; ------------------------------
;
; Non Returning Routine.
VIRTUAL_ROUTINE L2ERRORHAND1, PAGE_DOSERROR1
;
; ------------------------------
; Code Required Starts Here
; Copied From TRS DOS 2.3
; ------------------------------
; code is invoked from Dos Exit $41a6
; from call location 19EC in l2 Roms
; ------------------------------
;
   pop	hl                   ; 57e6: - POP the Call off the Stack
   ld	hl,L2ERRTAB          ; 57e7: error table 5203 - 54c3 ($2c0 bytes)
   ld	a,e                  ; 57ea: error number is passed in E
   cp	$2C + 1              ; $2C is largest handled by L2 Basic
   jp	nc,L2ERRORHAND2      ; 57ed: ** PAGE JUMP ** an error code too big to display
   ;
   rrca                      ; 57fb: 0,2,4 -> 0,1,2
   inc	a                    ; 57fc: 0,1,2 -> 1,2,3
   ld	e,a                  ; 57fd:
_errloop
   call	$1f07                ; 57fe: routine skips forward (HL) looking for 0 term
   				; todo 1f07 (NON STANDARD ENTRY) investigate and document its usage.
   dec	e                    ; 5801: error count down
   inc	hl                   ; 5802: inc past 0 terminator
   jr	nz,_errloop          ; 5803: still more errors LOOP
   call	$28a7                ; 5805: Here is where we display the message
   ld	hl,($40a2)           ; 5808: current line number
;
   jp	$1A0A		     ; entry point back into error handler.
   			     ; slightly earlier than TRSDOS does it.
;   PREVIOUSLY
;   ld	de,$fffe             ; 580b: ???
;   rst	$0018                ; 580e: compare
;   jp	z,5c06		     ; 580f: Start of the BASIC program (Jumped to at the ORG)
;   call 64f2                ; 5812: IGNORE RETurn or CLEAR MEMORY if the error is such that protection must clear RAM
;   jp	$1a11                ; 5815: continue with error message " in line number"

L2ERRTAB
    ; The error table in range $00 to $2C (44)
    DEFB $00
    DEFB "NEXT without FOR", $00	; 00
    DEFB "Syntax error", $00		; 02
    DEFB "RETURN without GOSUB", $00	; 04
    DEFB "Out of DATA", $00		; 06
    DEFB "Illegal function call", $00	; 08
    DEFB "Overflow", $00		; 0A
    DEFB "Out of memory", $00		; 0C
    DEFB "Undefined line number", $00	; 0E
    DEFB "Subscript out of range", $00	; 10
    DEFB "Redimensioned array", $00	; 12
    DEFB "Division by zero", $00	; 14
    DEFB "Illegal direct", $00		; 16
    DEFB "Type mismatch", $00		; 18
    DEFB "Out of string space", $00	; 1A
    DEFB "String too long", $00		; 1C
    DEFB "String formula too complex",0 ; 1E
    DEFB "Can't continue", $00		; 20
    DEFB "No RESUME", $00		; 22
    DEFB "RESUME without error", $00	; 24
    DEFB "Unprintable error", $00	; 26
    DEFB "Missing operand", $00		; 28
    DEFB "BAD FILE DATA", $00		; 2A
    DEFB "DISK BASIC FEATURE", $00	; 2C
;
; ------------------------------
; End of Paged Routine
; ------------------------------
pageEnd
;
; ------------------------------
;
; Non Returning Routine.
VIRTUAL_ROUTINE L2ERRORHAND2, PAGE_DOSERROR2
;
; ------------------------------

	; TODO NOTE THIS CODE IS NOT COMPLETE
	; TODO We HAVE NOT DIS BASIC CODE THAT GENERATES ERRORS

	ld 	hl,UNPRINTABLE
	call	$28a7                ; 5805: Here is where we display the message
	ld	hl,($40a2)           ; 5808: current line number
	jp	$1A0A		     ; entry point back into error handler.

UNPRINTABLE
    DEFB "Unprintable error", $00

    ; in future we can enable the dos errors
    ; called from the prior routine to handle
    ; the disk basic errors


   ld	hl,L3ERRTAB          ;
;  cp	$8b                  ; 57eb: 8BH (139) which is the highest error number.
   cp	$2C                  ; ACTUALLY $2C is largest handled by L2 Basic
   jp	nc,_57f7             ; 57ed: an error code too big to display
;  cp	$63                  ; 57ef: 63H (99) the disk error list.
;  jr	nc,_57f9             ; 57f1: we have a disk error, so JUMP to NTDER2 to handle that
;  cp	$2f                  ; 57f3: error code is between last ROM error and first DISK error message
;  jr	c,_57fb              ; 57f5: it's not, its a basic error
   jr	_57fb                ; 57f5: its a basic error
_57f7
   ld	a,$5a                ; 57f7: "UNPRINTABLE ERROR" $52-$34 -> $1E (unprinable)
_57f9
   sub	$34                  ; 57f9: process the error into an offset
_57fb
   rrca                      ; 57fb: divide by 2
   inc	a                    ; 57fc:
   ld	e,a                  ; 57fd:
_57fe
   call	$1f07                ; 57fe:
   dec	e                    ; 5801:
   inc	hl                   ; 5802:
   jr	nz,_57fe             ; 5803:
   call	$28a7                ; 5805: Here is where we display the message
   ld	hl,($40a2)           ; 5808: current line number
   jp	$1A0A		     ; entry point back into error handler.



L3ERRTAB
	; Disk Errors Start Here (TRSDOS)
	; Error 51 starts here - ending in 70
	DEFB $00
	DEFB "FIELD overflow", $00
	DEFB "Internal error", $00
	DEFB "Bad file number", $00
	DEFB "File not found", $00
	DEFB "Bad file mode", $00
	DEFB "File already open", $00
	DEFB "?", $00
	DEFB "Disk I/O error", $00
	DEFB "File already exists", $00
	DEFB "?", $00
	DEFB "?", $00
	DEFB "Disk full", $00
	DEFB "Input past end", $00
	DEFB "Bad record number", $00
	DEFB "Bad file name", $00
	DEFB "Mode-mismatch", $00
	DEFB "Direct statement in file", $00
	DEFB "Too many files", $00
	DEFB "Disk write protected", $00
	DEFB "File access DENIED", $00
	; And ending in Error 70
	; Note NEWDOES 80 DEFINES up to 84 errors
;
; ------------------------------
; End of Paged Routine
; ------------------------------
pageEnd
;
; ------------------------------
; DOS ENTRY VECTOR
; ------------------------------
;
	ORG	$41a6
	jp	L2ERRORHAND1
;
; ------------------------------
; CODE ENDS HERE
; ------------------------------
	; After loading return to DOS
	END	$402D
;

