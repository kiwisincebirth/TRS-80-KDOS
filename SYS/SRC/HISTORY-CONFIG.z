; ======================================================================
; Optional HistorySize configuration reader
;
; Read /SYS/settings.cfg once on first DOS input, using the existing file API.
; This is a kDOS software setting; the Pico does not parse it. The caller sets
; hist_cfg_loaded before entering, so missing/bad files are not retried on
; every prompt and this optional read never becomes part of the boot path.
;
; Recognize a case-insensitive HistorySize key, optional whitespace around
; =, decimal digits, and # or ; trailing comments. CR/LF and an initial UTF-8
; BOM are accepted. Unknown lines are skipped. A recognized invalid assignment
; uses the default; positive values above HISTORY_MAX clamp to that maximum.
; Later recognized assignments can replace earlier ones.
;
; The byte reader observes each block's actual length and DRQ status. A read
; budget and bounded BUSY polling prevent malformed/oversized files or an
; unresponsive device from trapping the user before the DOS prompt. Read
; failures fall back to the default; configuration errors are not DOS errors.
;
; Parsing state lives in the first history data bank. Return restores the
; caller's data selector; the callable trampoline restores its code bank.
;
; Original kDOS by kiwisincebirth. Formatted with 8-column tab stops.
; ======================================================================
VIRTUAL_ROUTINE history_config_page, PAGE_HISTORYCFG
	ld	a,(PICOPAGEDAT)
	push	af
	PAGE_DATA	DPAGE_DOSHISTORY
	ld	a,HISTORY_DEFAULT
	ld	(hist_limit),a
	xor	a
	ld	(hist_cfg_left),a
	ld	a,64               ; at most 16 KiB of config, even if EOF is faulty
	ld	(hist_cfg_budget),a
	; OPEN payload is mode + filename bytes + NUL, including both extra bytes.
	ld	a,_filename_end-_filename+2
	out	(APISIZE),a
	ld	a,OPENFILE
	out	(APICMND),a
	ld	a,FA_READ|FA_OPEN_EXIST
	out	(APIDATA),a
	ld	hl,_filename
	ld	bc,(_filename_end-_filename)*256+APIDATA
        otir
	xor	a
	out	(APIDATA),a
	call	_wait
	jp	nz,_return       ; absent/unreadable config is not a boot error
	call	_get
	jp	c,_finish
	cp	$EF                ; optional UTF-8 BOM at start of file
	jr	nz,_first
	call	_get
	jp	c,_finish
	cp	$BB
	jp	nz,_skip
	call	_get
	jp	c,_finish
	cp	$BF
	jp	nz,_skip
_line:
	call	_get
	jp	c,_finish
_first:
	cp	ENTER
	jr	z,_line
	cp	LINEF
	jr	z,_line
	cp	SPACE
	jr	z,_line
	cp	TAB
	jr	z,_line
	ld	hl,_key
_keychar:
	and	$DF                ; case-insensitive ASCII key
	cp	(hl)
	jp	nz,_skip
	inc	hl
	call	_get
	jp	c,_finish
	ld	b,a
	ld	a,(hl)
	or	a
	ld	a,b
	jr	nz,_keychar
_equals:
	; Require = after the complete key, so HistorySizeExtra cannot match.
	cp	SPACE
	jr	z,_eqnext
	cp	TAB
	jr	z,_eqnext
	cp	'='
	jp	nz,_skip
	ld	a,HISTORY_DEFAULT   ; invalid recognized assignment uses default
	ld	(hist_limit),a
	xor	a
	ld	(hist_cfg_value),a
	ld	(hist_cfg_digits),a
	jr	_value_start
_eqnext:
	call	_get
	jp	c,_finish
	jr	_equals
_value_start:
	call	_get
	jr	c,_accept_eof
	cp	SPACE
	jr	z,_value_start
	cp	TAB
	jr	z,_value_start
_digit:
	cp	'0'
	jr	c,_tail
	cp	'9'+1
	jr	nc,_tail
	sub	'0'
	ld	b,a
	ld	a,1
	ld	(hist_cfg_digits),a
	ld	a,(hist_cfg_value)
	cp	HISTORY_MAX+1       ; saturate before arithmetic can overflow
	jr	nc,_nextdigit
	; Decimal accumulation: value * 10 + digit, saturated at MAX + 1.
	; That sentinel preserves "too large" without allowing byte overflow.
	ld	c,a
	add	a,a
	add	a,a
	add	a,c
	add	a,a
	add	a,b
	cp	HISTORY_MAX+1
	jr	c,_storevalue
	ld	a,HISTORY_MAX+1
_storevalue:
	ld	(hist_cfg_value),a
_nextdigit:
	call	_get
	jr	nc,_digit
_accept_eof:
	; A valid final assignment does not require a trailing line ending.
	call	_accept
	jr	_finish
_tail:
	cp	ENTER
	jr	z,_accept_line
	cp	LINEF
	jr	z,_accept_line
	cp	'#'
	jr	z,_accept_comment
	cp	';'
	jr	z,_accept_comment
	cp	SPACE
	jr	z,_tailnext
	cp	TAB
	jr	nz,_skip         ; reject suffixes such as 12abc or 1 2
_tailnext:
	call	_get
	jr	c,_accept_eof
	jr	_tail
_accept_line:
	call	_accept
	jp	_line
_accept_comment:
	push	af
	call	_accept
	pop	af
_skip:
	cp	ENTER
	jp	z,_line
	cp	LINEF
	jp	z,_line
	call	_get
	jr	nc,_skip
_finish:
	; Once OPEN succeeds, close even after parse/read failure; ignore close
	; errors because this optional setting must still return to the prompt.
	ld	a,CLOSEFILE
	out	(APICMND),a
	call	_wait
_return:
	pop	af
	ld	(PICOPAGEDAT),a
        ret
_accept:
	ld	a,(hist_cfg_digits)
	or	a
	ret	z
	ld	a,(hist_cfg_value)
	or	a
	ret	z                  ; zero is invalid; retain the default
	cp	HISTORY_MAX+1
	jr	c,_setlimit
	ld	a,HISTORY_MAX
_setlimit:
	ld	(hist_limit),a
        ret
_get:
; Read using actual block length and DRQ, not api_READBYTE's fixed 256 bytes.
; C=EOF/read failure; NC=byte in A. NUL terminates padded/text data safely.
	ld	a,(hist_cfg_left)
	or	a
	jr	nz,_readbyte
	ld	a,(hist_cfg_budget)
	or	a
	jr	z,_readerror
	dec	a
	ld	(hist_cfg_budget),a
	xor	a
	out	(APISIZE),a
	ld	a,READFILE
	out	(APICMND),a
	call	_wait
	jr	nz,_readerror
	and	STATUS_DRQ
	jr	z,_eof
	in	a,(APISIZE)          ; zero represents a full 256-byte block
	ld	(hist_cfg_left),a
_readbyte:
	; A full block starts at zero: decrement wraps to 255 on its first byte.
	ld	a,(hist_cfg_left)
	dec	a
	ld	(hist_cfg_left),a
	in	a,(APIDATA)
	or	a
	ret	nz                 ; OR clears carry
_eof:
        scf
        ret
_readerror:
	; Invalidate partial digits so EOF handling cannot accept a truncated value.
	xor	a
	ld	(hist_cfg_digits),a
	ld	a,HISTORY_DEFAULT
	ld	(hist_limit),a
	jr	_eof
; Configuration is optional: bound BUSY polling rather than using the
; general api_WAIT, which currently has no timeout. Preserve BC/HL/DE.
; Keep this optional-read policy local until shared API timeout semantics
; and FreHD timing have been agreed and tested.
_wait:
	push	bc
	ld	bc,0		; wraparound allows 65,536 polls, not a calibrated delay
_poll:
	in	a,(APISTAT)
	bit	STATB_BUSY,a
	jr	z,_ready
	dec	bc
	ld	a,b
	or	c
	jr	nz,_poll
	ld	a,1
	or	a                  ; timeout returns NZ, like a file API error
	pop	bc
        ret
_ready:
	bit	STATB_ERR,a
	pop	bc
        ret
_key: db 'HISTORYSIZE',0
_filename: db '/SYS/settings.cfg'
_filename_end:
VIRTUAL_END
