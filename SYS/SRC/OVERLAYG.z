; ======================================================================
;       	KDOS
;	based on TRSDOS, LDOS, and NEWDOS/80 for Model 1
;
;     FILE HANDLING FOR DOS API's @ $4400 - $4480
;	Deals with Access to Data in an Open File
;	( See Overlay F for the Open/Close functions )
;
;     Source Code Created By : kiwisincebirth - 2026
;     [https://github.com/kiwisincebirth/TRS-80]
;
; ======================================================================
;     NOTE: this code has been formatted with 8 spaces per tab
; ----------------------------------------------------------------------
;
import	constants.z
;
; ======================================================================
; Overlay Region (4500h - 4700h)
; ======================================================================
;
	ORG	OVERLY

	; Check if running enhanced - Error Out if not running on Pico
	push	af		; preserve the Super CALL ID
	CALL	enh_VER		; test if Enhanced Pico (NZ flag)
	jr	z,_NOT_ENH	; Only works on Enhanced - Escape Out
	;
	; Generic Code all Routines to Set FCB into IX
	push	de		; get fcb into IX for use
	pop	ix		; in ALL functions
	;
	; And Pass the File ID to The PICO
       	ld     	a,(ix+FCB_FILEID) ; file id from FCB
       	out    	(APIFILE),a	; set file ID into Pico
	;
	; Now decode which function to call
	pop	af		; Get the call id back
	;
	cp	S_READFILE	; (4436) @READ API Function
	jp	z,_readfile
	;
	cp	S_WRITEFILE	; (4439) @WRITE API Function
	jp	z,_writefile
	;
	cp	S_VERIFYFILE	; (443C) @VER API Function
	jp	z,_verifyfile
	;
	cp	S_REWFILE	; (443F) @REW API Function
	jp	z,_rewindfile
	;
	cp	S_POSNFILE	; (4442) @POSN API Function
	jp	z,_positionfile
	;
	cp	S_BKSPFILE	; (4445) @BKSP API Function
	jp	z,_backspacefile
	;
	cp	S_PEOFFILE	; (4448) @PEOF API Function
	jp	z,_eoffile
 	;
	ld	a, INTDOSERR$	; Internal Failure
	jp	@ERROR
	;
_NOT_ENH
	pop	af		; restore the stack
_ILLEGAL
	ld	a, ILLDOSFUN$	; (NOT enhanced) so illegal Dos Function
	or	a		; set the flags
	ret			; return failure
;
; ----------------------------------------------------------------------
;
; @READ READ File ($4436)
; Read a record from Disk, based on LRL specified at open time FCB+1(Bit7)
; If LRL = 256 (0) record will be placed in the IO buffer (held in FCB)
; If LRL < 256 record will be placed in buffer specified in Argument
; DE -> Pointer to FCB 32 byte Buffer
; HL -> User Record Buffer address for LRL <256, ignored for LRL=256
; Ret Z - No Error ; NZ - Error (A error Code)
; FCB Next Record num - increased by number of bytes Read
;
_readfile
	; Send the Command
	ld	a,TRS_FILE_READ		; API READ command
	out	(APICMND),a		; send command

	; Wait and return if error
	CALL	api_WAIT		; wait for status
	ret	nz			; error then out of here

	; receive the data buffer
	CALL	_LRL_FCB		; Set A = files LRL, and If 256 (0)
					; then overwrite HL from FCB
	ld	b,a			; LRL record length from A
	ld	c,APIDATA			; read block from PORT
	INIR				; load N bytes into Buffer
	;
	; Sync Files FCB Metadata - RETURNING to caller
	JP	_sync_META		; Sync Metadata into FCB
;
; ----------------------------------------------------------------------
;
; @VER  Write and VERIFY File ($443C)
; Same as @WRITE
; Noting the documentation states that it re-reads the sector,
; it doesnt talk about Updating the Directory with Current EOF
;
_verifyfile
	; FALL Through to _writefile
;
; @WRITE WRITE (no verify) File ($4439)
; DE -> Pointer to FCB 32 byte Buffer
; HL -> User Record Buffer address for LRL <256 ; !=0
; Ret Z - No Error ; NZ - Error (A error Code)
; FCB Next Record num - increased by number of bytes Written
; FCB EOF - Updated (conditionally) after write to equal NEXT
;   * If NEXT exceeds EOF
;   * If FCB+1 (Bit6 = 0) - the default when opening a file
;
_writefile
	; Send the Command
	ld	a,TRS_FILE_WRITE	; API WRITE command
	out	(APICMND),a		; send command
	;
	; write the data buffer
	CALL	_LRL_FCB		; Set A = files LRL, and If 256 (0)
					; then overwrite HL from FCB
	ld	b,a			; LRL record length from A
	ld	c,APIDATA			; write block to PORT
	OTIR				; write N bytes to Pico

	; Wait and return if error
	CALL	api_WAIT		; wait for status
	ret	nz			; error then out of here

	; Sync Files FCB Metadata - RETURNING to caller
	JP	_sync_META		; Sync Metadata into FCB
;
; ----------------------------------------------------------------------
;
; @REW  Position to start of file SOF ($443F)
; DE -> Pointer to FCB 32 byte Buffer
; Ret Z - No Error ; NZ - Error (A error Code)
; FCB Next Record num - will be set to 0
;
_rewindfile:
	ld     	a,TRS_FILE_SOF		; command to execute
	out    	(APICMND),a         	; Write the File Seek command
	jr	_position_finish
;
; @BKSP Backspace One Record ($4445)
; DE -> Pointer to FCB 32 byte Buffer
; Ret Z - No Error ; NZ - Error (A error Code)
; FCB Next Record num - decreased by LRL
;
_backspacefile
	ld     	a,TRS_FILE_BACK		; command to execute
	out    	(APICMND),a         	; Write the File Seek command
	jr	_position_finish
;
; @PEOF Position to End Of File  EOF ($4448)
; DE -> Pointer to FCB 32 byte Buffer
; Ret Z - No Error ; NZ - Error (A error Code)
; FCB Next Record num - Set to EOF
;
_eoffile
	ld     	a,TRS_FILE_EOF		; command to execute
	out    	(APICMND),a         	; Write the File Seek command
	jr	_position_finish
;
; @POSN Position to a specified record ($4442)
; DE -> Pointer to FCB 32 byte Buffer
; BC -> Logical Record Number (0= first record)
; Ret Z - No Error ; NZ - Error (A error Code)
; FCB Next Record Num = LogRecLength * LogRecNumber
;
_positionfile
	ld     	a,TRS_FILE_POS		; command to execute
       	out    	(APICMND),a         	; Write the File Seek command
	;
	; Send the 2-byte Record Number (BC)
	ld     a,c
	out    (APIDATA),a            ; LSB
	ld     a,b
	out    (APIDATA),a            ; MSB (This triggers Step 2 on Pico)
	;
_position_finish
       	call   	api_WAIT             	; Wait for Pico to complete seek
       	ret     nz			; if error then exit out
       	;
	JP	_sync_META_POS		; NOW sync the local FCB -> and RET
;
; ----------------------------------------------------------------------
;
; Routine to get File FCB data back updated from last operation
;
_sync_META
	ld	a, TRS_FILE_FCB		; send command to
	out  	(APICMND), a		; Ask for the 9-byte update
	;
_sync_META_POS
	; Calculate local FCB offset 5
	push 	hl                 	; Save current data pointer
	;
	ld	a,FCB_NEXTLSB		; Byte 5 of FCB is start of update
	add	e			; add to the FCB LSB
	ld	l,a			; write LSB to L
	ld	h,d			; get MSB into H (16 bit address
	jr	nc, _sync_m1		; skip
	inc	h			; if Carry, then bump MSB
_sync_m1
	;
	ld   	bc, $900 + APIDATA	; Get 9 bytes from IN (DATA)
	INIR                    	; Update bytes 5-13
	;
	pop  	hl                 	; Restore saved pointer
	ret
;
; ======================================================================
;
; GET LRL and Buffer Address
; Entry  HL, contains buffer address from CALLer
; 	 IX contains the FCB address
; Return HL address for targets data, updated if LRL = 256
;        A The LRL
;
_LRL_FCB:
	;
    	; Pico has set SIZE to LRL (e.g., 0 for 256)
    	; IN   A, (APISIZE)		; get bytes from Pico
	;
	ld	a,(IX+FCB_LRL)		; get LRL from FCB
	or	a			; set flags based on LRL
	ret	nz			; Ret If LRL != 256 (0) -> HL passed in is OK
	;
	ld	l,(IX+FCB_BUFFLSB)	; otherwise LRL=0 so get Buff Address from FCB
	ld	h,(IX+FCB_BUFFMSB)	; defined when the file was opened -> Set HL
	;
	ret
;
; ======================================================================
; 4700 - End Of Overlay
; ======================================================================
;
FREE_OVERLAYG	EQU	OVERLY + $200 - $
;
	; FILL to end of REGION
	DC	FREE_OVERLAYG - 1,0
	DB	$0F
;
