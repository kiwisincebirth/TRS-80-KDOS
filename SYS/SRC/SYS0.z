; ======================================================================
;       	MINI DOS
;	based on TRSDOS, LDOS, and NEWDOS/80 for Model 1
;
;     SYS0 - CORE SYS0 Module
;
;     Source Code Created By : kiwisincebirth - 2026
;     [https://github.com/kiwisincebirth/TRS-80]
;
; ======================================================================
;     NOTE: this code has been formatted with 8 spaces per tab
; ----------------------------------------------------------------------
;
; ======================================================================
; Level 2 Communication Region (4000h - 4200h)
; ======================================================================
;
	ORG	$400C
	jp	SUPER_EXEC	; (400C) RST 28H Supervisor Call Dispatcher;
;	ORG	$400F		; (400F) RST 30h (DOS DEBUG entry point) Vector.
;
	ORG	$4012
	jp	INTERRUP_SR	; (4012) RST 38h (Interrupt Service) Vector.
;
	ORG	$402D
	jp	RESETR		; (402D) No-Error Exit same as 4400
	jp	RESETR		; (4030) Error-already-displayed DOS Error Exit.
;
	ORG	$4033		;
	jp	CIODOS		; (4033) DOS Char I/O Driver for Disk Files

	; ORG	$403E
	; todo on TRSDOS $403E holds a version number
	; LDOS - Contains the operating system version Number
	; In  ND80 V1, 4Ø3EH contained either 8Ø (5ØH) or 128 (8ØH).
	; FOR ND80 V2 this contains FF or 00 -> SEE 4427 442B

	ORG	TICKCNT
	DB	0	; (4040H) Timer Tick
	; todo the following should not be overridden on warm start
	DB	59	; (4041H) Seconds counter (binary, 0-59) XTIME
	DB	59	; (4042H) Minutes counter (binary, 0-59)
	DB	11	; (4043H) Hours counter (binary, 0-23)
	DB	26	; (4044H) Year counter (binary, offset 2000)
	DB	1	; (4045H) Day counter (binary, 1-31)
	DB	4	; (4046H) Month counter (binary, 1-12)
	DW	DOSEND	; (4047H) Utility load address (normally $5200).
	DW	$FFFF	; (4049H) DOS highest RAM address (MEMEND)
			; Updated by init, after L2 MEM Size? Check
;
; ----------------------------------------------------------------------
; Specific Values (to our DOS) that need to be Loaded
; Previously copied here from Level 2 ROM -> 18F7-1904, by code at $0075
; ----------------------------------------------------------------------
	ORG	$40A0
;
	DEFW	L2START+$64	;40A0 (STKTOP) - BASIC String Storage Area (was $434C)
	DEFW	$FFFE		;40A2 (CURLIN) - Current BASIC Line Number
	DEFW	L2START+1	;40A4 (TXTTAB) - BASIC Program Statement Table (was $41E9)
	DEFB	0		;40A6 (TTYPOS) - Cursor pos on VDU line. See POS function.
	DEFW	STRBUFF+3	;40A7 (BUFPNT) - Main command line (KB) Input buffer.
;
; ----------------------------------------------------------------------
; (4152-41A5) DOS BASIC commands
;
; MOST of these are set separately. as part of the loading of each function.
; As they dont use the supervisor Overlay call mechanism,
; Instead they are loaded as Direct Paged memory Calls.
; ----------------------------------------------------------------------
	ORG	$4152
;
	jp	L3ERR		; CVI - $4152
	jp	L3ERR		; FN  - $4155 - Done
	jp	L3ERR		; CVS - $4158
	jp	L3ERR		; DEF - $415B - Done
	jp	L3ERR		; CVD - $415E
	jp	L3ERR		; EOF - $4161
	jp	L3ERR		; LOC - $4164
	jp	L3ERR		; LOF - $4167
	jp	L3ERR		; MKI - $416A
	jp	L3ERR		; MKS - $417D
	jp	L3ERR		; MKD - $4170
	jp	L3ERR		; CMD - $4173 - ? User Definable ?
	jp	L3ERR		; TIME$ $4176 - Done
	jp	L3ERR		; OPEN  $4179
	jp	L3ERR		; FIELD $417C
	jp	L3ERR		; GET - $417F
	jp	L3ERR		; PUT - $4182
	jp	L3ERR		; CLOSE $4185
	SUPERV	S_BASICLOAD	; LOAD  $4188
	jp	L3ERR		; MERGE $418B - todo similar to LOAD
	jp	L3ERR		; NAME  $418E
	jp	L3ERR		; KILL  $4191 - todo same as #DELETE
	jp	L3ERR		; &   - $4194 - Done
	jp	L3ERR		; LSET  $4197
	jp	L3ERR		; RSET  $419A
	jp	L3ERR		; INSTR $419D - Done
	SUPERV	S_BASICSAVE	; SAVE  $41A0
	jp	L3ERR		; LINE  $41A3 - Done
;
; ----------------------------------------------------------------------
; (41A6-41E2) DOS Exit links
; ----------------------------------------------------------------------
	ORG	$41A6
;
	RET3		; 41A6 - Done - Extended Disk Basic Errors
	RET3		; 41A9 - Done - USR N extended processing
	jp	READY1  ; 41AC - Command Processor. Just before READY>
	RET3		; 41AF
	RET3		; 41B2
	RET3		; 41B5
	RET3		; 41B8
	RET3		; 41BB
	RET3		; 41BE
	RET3		; 41C1
	RET3		; 41C4
	jp	RUNCMD	; 41C7 - RUN NNN processing to handle RUN "x.BAS"
	RET3		; 41CA
	RET3		; 41CD
	RET3		; 41D0
	RET3		; 41D3
	RET3		; 41D6
	RET3		; 41D9 - Done - MID$() Does exit for extended use
	RET3		; 41DC
	RET3		; 41DF
	RET3		; 41E2 - SYSTEM command (potentially use this)
;
; ======================================================================
; ======================================================================
; 42E0 - Start of Main Routines
; ======================================================================
; ======================================================================
	ORG	CORE1
;
; Entry point for the DOS Exit just before READY Message -> PRGFIN
; This allows the DOS to process commands via the L2 Basic Ready prompt
;
NEWREADY
	;
	; first some tests to see if not entering normal Ready command processing
	; if So we return and let l2 basic handle these cases for us.
	;
	; SN Error - with Line number
	ld	a,(ERRFLG)	;1a2b - load A with the value of the current error code
	cp	ERRSN		;1a2e - compare with SYNTAX ERROR
	jr	nz,_NEWRDY1	;1a30 - If NOT an SN ERR, Skip forward
	;
	; AND Line number Involved
	ld	hl,(ERRLIN)	;2e56 - what line number. $FFFF if a direct command
	ld	a,h		;2e59 - Loads A with H, since A already Zero
	and	l		;2e5a - AND with L, So FF if a Direct command
	inc	a		;2e5b - FF -> bump to 00 -> meaning Direct command
	ret	nz		;2e5d - Found Line Num So Back so can EDIT <line>
	;
_NEWRDY1
	;
	; AUTO progarm entry Mode
	ld	a,(AUTFLG)	;1a39 - Auto Flag NOT zero if in Auto Mode
	or	a		;1a3c - set flags
	ret	nz		;1a3d - NZ means we are in auto mode
	;
	; now we can process REDY in a standalone way.
	; Wont use return from this point
	pop	hl		; pop the (DOS EXIT) callers return address. Discard
	;
	; Jump to the main command processor
	SUPERV	S_CMDPROC
;
; L2 Basic RUN command DOS Exit Extension (41C7)
; Support for RUN "xxxx.BAS" command
;
RUNCMD:
	ret	c		; If line number (C Flag) so RET and continue as normal.
	SUPERV	S_BASICRUN	; otherwise load and process RUN command.
;
; ----------------------------------------------------------------------
;
; @DSPLY (4467) - DOS display string routine
;   Code based on ND80 SYS0 (4BA6H)
;
DISPSTR:
	push	DE		; Save DE onto stack.
	LD	DE,401DH	; Load DE with 401DH (video output DCB).
	JR	_DSPSTR1	; JUMP to common print loop.
;
; @PRINT (446A) - DOS Print String Routine
;   Code based on ND80 SYS0 (4BA6H)
;
PRINTSTR:
	push	DE		; Save DE (alternate print entry).
	LD	DE,4025H	; Load DE with 4025H (printer DCB).
_DSPSTR1:
	push 	HL		; Save string pointer.
_DSPSTR2:
	LD	A,(HL)		; Fetch character from string.
	CP	00H		; Compare with 00 terminator
	JR	Z,_DSPSTR9	; finished
	CP	03H		; Compare with ETX (03H end marker).
	JR	Z,_DSPSTR9	; finished
	CALL	001BH		; display character
	LD	A,(HL)		; re fetch character.
	CP	0DH		; Compare with CR (carriage return).
	INC 	HL		; string pointer.
	JR	NZ,_DSPSTR2	; not CR, LOOP for next character.
_DSPSTR9:
	POP	HL
	POP	DE
	ret
;
; ----------------------------------------------------------------------
;
; CIO Routine for DOS Devices
CIODOS:
	; TODO This is the Disk File IO for bytes - IT IS responsible
	; for reading writing single bytes to disk files with
	; ** TBC **
	; c -> The character to PUT
	; DE -> pointer to the Files FCB
	ld	a,$00
	ret
;
; ======================================================================
;
; Open A file
; de pointer to the filename
; b  the length of the filename
; c  The open FA_* options - e.g. FA_OPEN_EXIST|FA_READ
frehd_OPEN:
	ex	de,hl		; file pointer into HL

	ld	a,b		; filename length
	inc	a		; +1 for options
	inc	a		; +1 for terminator
	out	(SIZE2),a	; write to FreHD size register
	;
	ld	a,OPENFILE	; open file command
	out	(COMMAND2),a	; send command to frehd
	;
	ld	a,$FF		; Set as though we have just read last (255) byte
	ld	(FHDBYTE),a	; so next readbyte will force a read of 256 bytes
	;
	; call	frehd_WAIT	; ignore result
	;
	ld	a,c		; file open options
	ld	c,DATA2		; Data 2 register address
	out	(c),a		; send command options to DATA2
	otir			; send filename, length in B, to DATA2
	ld	a,0		; null terminator
	out	(c),a		; send terminator
	;
	call	frehd_WAIT	; wait for status
	;
	ret
;
; Close the current File
frehd_CLOSE:
	ld	a,CLOSEFILE	; close file
	out	(COMMAND2),a
	call	frehd_WAIT	; ignoring result
	ret
;
; Command to init the
; Read a Block of 256 Bytes
frehd_READ:
	xor	a		; request 256 bytes from FreHD File
	out	(SIZE2),a	; Set the FreHD Size register
	ld	(FHDBYTE),a	; reset the byte counter, 0 bytes used
	;
	ld	a,READFILE	; command
	out	(COMMAND2),a	; send command
	;
	call	frehd_WAIT	; wait for status
	ret
;
; Read a Single Byte
; Note Only Used by Basic and Loader, not by Sys0 itself. - consider movng
frehd_READBYTE:
	push	hl
	ld	hl,FHDBYTE	; byte counter
	inc	(hl)		; we are reading next byte, byte counter++
	pop	hl
	jr	nz,read2	; skip over BLOCK read if not required
	;
	call	frehd_READ	; every 256 bytes, need another 256 bytes
	ret	nz		; return if read error
read2:
	xor	a		; clear flags, Z = true indicates no error
	in	a,(DATA2)	; get a byte from FreHD, leaving flags alone
	ret
;
;BYTEC	DEFB	0		; num bytes before need another READ
;				; used by Read Block handler
;
; wait until the interface is ready
; return
; Z is success, Status Bit for Error is 0
; 	Register A : Status code with all bits
; NZ if there was an error
;	Register A : The Dos Error Code
;
frehd_WAIT:
	ex 	(sp),hl		; small delay to
	ex 	(sp),hl		; settle the controller
	;
_wait1:	in 	a, (STATUS)	; read status from FreHD
	bit	STATB_BUSY,a	; BUSY status bit
	jr 	nz, _wait1	; loop while busy, for correct status
	;
	; in 	a, (STATUS)	; read status again
	bit	STATB_ERR,a	; test the LSB bit (STATUS_ERR)
	ret	z		; No error just return the status
	;
	in	a, (ERROR2)	; read the FF error code from frehd

	; The error code is mapped in the following way (bit 7 removed)
	;   as 0 -  20 FF  Error -> map to 64- 128 by  setting Bit 6,
	; and 64 - 192 TRS Error -> map to  0-  63 by removing Bit 6,
        bit	6,a
        jr	nz,_waitTRS	; Not Zero -> TRS-error
        			; otherwise FF error
_waitFF
	and	$3F
	or	$40		; FF Err -> Mask as 01xxxxxx
	ret
_waitTRS
	and	$3F		; TRS Err -> Mask as 00xxxxxx
	ret
;
; ----------------------------------------------------------------------
;
; ENTRY POINT FOR ALL INTERRUPTS (4012)
;
INTERRUP_SR:
	push	af
	ld	a,($37e0) 	; clear the RTC interrupt latch
	rlca			; mve bit 7 into the CARRY regster
	jr	nc,INTERRUP_EXIT ; If NO timer interrupt, skip
;
ifdef @D_PICOENHANCED
	push	hl
	push	de
	push	bc		; Main Interrupt Handler
	call	SCR_INT_SERV	; call the main Service Routine
	pop	bc
	pop	de
	pop	hl
else
;
	; SIMPLE Interrupt Handler
	push	hl
	ld	hl,TICKCNT	; timer tick
	inc	(hl)		; increment the timer tick
	pop	hl
endif
INTERRUP_EXIT:
	pop	af
	ei
	RET			; todo reti
;
; ======================================================================
;
$FREE_CORE1	EQU	SYSFCB - $
;
	; FILL to end of REGION
	assert	$ <= SYSFCB
	DC	SYSFCB - $,0
;
; ======================================================================
;
	ORG	SYSFCB
	DC	$20,0		; 32 byte System FCB bock.
;
; ======================================================================
; 4400 - DOS Entry Points
; ======================================================================
	;
	ORG	DOSENTY
	; Note * below denotes routines that are different in NewDOS 80 VS TRSDOS 2.3
	;
	jp	RESETR		; (4400) @CMD No-Error Exit same as 402D
	NOP2			; and 44Ø3H - 44Ø4H contain the program's entry address. 4430
	jp	RESETR		; (4405) @CMNDI todo Execute a DOS command and return to DOS ready.
	nop
	ld	b,a		; (4409) @ERROR Error Exit - Display Error Messages
	SUPERV	S_ERRHAND	; Put error code into B -> displaying Disk Error Code
	RET3			; (440D) @DEBUG Enter Debug Mode from running program
	RET3			; (4410) @ADTSK Add an address to the Interrupt Task List Vector
	RET3			; (4413) @RMTSK Remove an address from the Interrupt Task List Vector
	RET3			; (4416) * LDOS Replace currently executing Task * ND80 Keep Drives Rotating
	RET3			; (4419) * LDOS Remove currently executing task  * ND80 exec CMD and return
	SUPERV	S_FILESPEC	; (441C) @FSPEC Extract / Fetch a file specification
	nop
	SUPERV	S_INITFILE	; (4420) @INIT (Create New or Open Existing File) Vector
	nop
	SUPERV	S_OPENFILE	; (4424) @OPEN (Open Existing File) Vector
	defb	$00		; (4427) todo ND8Ø $82 identifying ND(8)0v(2)
	SUPERV	S_CLOSEFILE	; (4428) @CLOSE Close an Open File
        defb	$01		; (442B) ND8Ø V2 $Ø1 if Model I and $Ø3 if Model III.
	SUPERV	S_KILLFILE	; (442C) @KILL Delete (Kill) FCB's associated file .
	nop
	SUPERV	S_LOADFILE	; (4430) @LOAD The LOAD CMD File Vector
	SUPERV	S_RUNFILE	; (4433) @RUN The (Load and) RUN CMD File Vector
	;
	SUPERV	S_READFILE	; (4436) @READ  READ File File
	SUPERV	S_WRITEFILE	; (4439) @WRITE WRITE (without verify) File
	SUPERV	S_VERIFYFILE	; (443C) @VER   Write and VERIFY Vector
	SUPERV	S_REWFILE	; (443F) @REW   Position FCB to start of file
	SUPERV	S_POSNFILE	; (4442) @POSN  Position FCB to a specified file record
	SUPERV	S_BKSPFILE	; (4445) @BKSP  BACKSPACE One Record
	SUPERV	S_PEOFFILE	; (4448) @PEOF  SKIP TO EOF (End of File)

	; todo 28 byte gap here, investigate
	assert	$ <= $444B
	ORG	$4467

	jp	DISPSTR		; (4467) @DSPLY display string routine.
	jp	PRINTSTR	; (446A) @PRINT print string routine.
	RET3			; (446D) @TIME todo Get the time "23:59:59" into (HL)
	RET3			; (4470) @DATE todo Get the date "12/12/99" into (HL)
	RET3			; (4473) @FEXT todo Insert a default extension into filename in FCB
	RET3			; (4476) * Ldos and Trsdos have a function defined here
	nop			; (4479)
	nop			; (447A)
	nop			; (447B)
	nop			; (447C)
	nop			; (447D)
	nop			; (447E)
	nop			; (447F)
;
	assert	$ == CORE2
;
; ======================================================================
; 4480 - Main Core Resident Code
; ======================================================================
	ORG	CORE2
;
; Internal USE only, not part of a public API, order may change
; entry points into basic utility functions called from overlay files
; if modifying below please edit constants.z ( referring to $4480 )
;
	JP	enhance_VER
	JP	frehd_OPEN
	JP	frehd_CLOSE
	JP	frehd_READ
	JP	frehd_READBYTE
	JP	frehd_WAIT
;
; ----------------------------------------------------------------------
; ----------------------------------------------------------------------
;
; Supervisor Execution based on RST Vector
;
SUPER_EXEC:
	;
	cp	BREAK_SUPERID	; we will get an 01 if BREAK key pressed during KB input.
	ret	z		; this short circuits and returns to the KB routine.
	;
	inc	sp		; discard the RST 28 return address
	inc	sp
	;
ifdef	@D_PICOENHANCED
;
	push	af
	;
; DOS Overlay in range E0 (224) to FF (255)
; Which needs to Map to addresses $3380 to $33FC
;
; These Map 1:1 to the Overlay Identifiers. Given Super Call ID
; * OR with    $E0  -> xxxxxxxx 111xxxxx
; * shift left < 2  -> xxxxxx11 1xxxxx00
; * or with $3000   -> 00110011 1xxxxx00
; This should resolve the Call Address
; The MSB is *ALWAYS* a constant $33
; The LSB is between $E0 thru $FC
;
	OR	$E0		; Mask is 111xxxxx (top 3 bits as 0)
	SLA	a		; then rotate to be 1xxxxx00
	SLA	a		; LSB is $80 -> $FC
	ld	(SUPER_EXEC2+1),a
	;
;	ld	a,$33		; MSB is $33
;	ld	(SUPER_EXEC2+2),a
	;
	pop	af		; restore registers
SUPER_EXEC2:
	jp	$3380		; instruction is modified above
	;
;
else
;
	push	hl		; Save all registers
	push	de		; preserved into the dispatched code
	push	bc
	push	af
	;
	; check for existing overlay, and skip if loaded
	and	$1F		; mask the sup call id - lower 5 bits
	add	SUP_OFF		; make it ascii 'A-Z'
	;
	ld	hl,OVRCURR	; pointer to the overlay number in file name
	cp	a,(hl)		; compare with current number
	jr	z,SUPER_EXEC2	; if already loaded then skip load
	ld	(hl),a		; update the current pointer
	;
	; open the overlay file
	ld	de,OVRNAM	; pointer to filename
	ld	b,OVRNAMLEN	; filename length
	ld	c,FA_OPEN_EXIST|FA_READ	; Read existing
	;
	call	frehd_OPEN
	ret	nz		; ERROR!!, then return - TODO Should be TRAPPED
	;
	call	frehd_READ	; send command to read 256 bytes
	ret	nz		; ERROR!!, then return - TODO Should be TRAPPED
	;
	ld	bc,DATA2	; transfer 256 bytes (B). C=port to read data
	ld	hl,OVERLY	; target binary address $4500
	inir			; read 256 bytes into (HL)
	;
	call	frehd_READ	; send command to read 256 bytes
	ret	nz		; ERROR!!, then return - TODO Should be TRAPPED
	inir			; read 256 bytes into (HL)
	;
SUPER_EXEC2:
	pop	af		; restore registers
	pop	bc		; including the original Supervisor call ID
	pop	de
	pop	hl
	;
	jp	OVERLY		; jump into the overlay code at $4500
;
; Overlay File name to use.
OVRNAM: 	DEFB	'/SYS/OVERLAYz.SYS'
OVRCURR:	EQU	$ - 5		; address of overlay ID in file name
OVRNAMLEN	EQU	$ - OVRNAM	; length of the overlay file name
;
endif
;
; ----------------------------------------------------------------------
;
; Signal if we have an Enhanced Version of DOS
; a  modified by this routine
; Z  - if a standard FreHD with standard firmware
; NZ - if an enhanced version with Advanced Pico firmware (A=1)
enhance_VER:

ifdef @D_PICOENHANCED
	; if compiling for Paged Memory then by definiton we are advanced
	ld	a,1		; FLAG TO INDICATE ON ENHANCED
else
	; otherwise we default to NO, and let the startup - modify this code
	ld	a,0		; load the A register (SELF MODIFY CODE)
endif
	or	a		; 0 -> is set to 1 during INIT if enhanced firmware
	ret			; set flags and return
;
; ----------------------------------------------------------------------
;
$FREE_CORE2	EQU	CORE2END - $
;
	; FILL to end of REGION
	assert	$ <= CORE2END
	DC	$FREE_CORE2 , 0
;
; ======================================================================
; 4600 - Overlay Code Area
; Empty until loaded
; ======================================================================
;
; ======================================================================
; 4700 - End Of MDOS
; ======================================================================
;
$FREE_TOTAL	EQU	$FREE_CORE1 + $FREE_CORE2

