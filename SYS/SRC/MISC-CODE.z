









; Below is From NewDos 80 v2 SYS 1
; https://www.trs-80.com/sub-disassem-dos-nd80-m1-sys01.htm
' supports extracting a filename from a string.

5163
PUSH HL
Save the current source pointer onto the stack.
5164
LD A,(HL)
Load Register A with the current character.
5165
SUB 30H
Subtract 30H (ASCII '0') from the character. This converts ASCII digits '0'-'9' to values 0-9.
5167
CP 0AH
Compare against 0AH (10 decimal). If the result is less than 10, the original character was a digit '0'-'9'.
5169
CALL 5189H
GOSUB to 5189H to check if the character is alphabetic (if not a digit). Returns CARRY if valid alphanumeric.
516C
JR NC,5184H
If NO CARRY (character is not alphanumeric), JUMP to 5184H to finish with an error/end condition.
Character passed the digit test or was confirmed alphabetic. Now check for special delimiters.

516E
LD A,(HL)
Reload the original character from the source.
516F
SUB 2EH
Subtract 2EH (ASCII '.') from the character. Testing for period (filename/extension separator).
5171
CP 0DH
Compare against 0DH. If the original character was between 2EH ('.') and 3AH (':'), this checks range.
5173
CALL 5189H
GOSUB to 5189H for additional character validation.
5176
JR C,517EH
If CARRY is set (character is a valid part of filename), JUMP to 517EH to copy it.
Character is a delimiter (like period) - mark end of filename portion.

5178
LD A,03H
Load Register A with 03H (end-of-text marker).
517A
LD (DE),A
Store the end-of-text marker into the destination buffer.
517B
POP AF
Discard the saved HL (stored at 5163H) by popping into AF.
517C
XOR A
Set Register A to zero and clear flags (Z FLAG set, indicating success).
517D
RET
Return to the caller with Z FLAG set indicating successful parse.
Character is valid - copy it to destination and continue loop.

517E
LD A,(HL)
Load the valid character from the source.
517F
LD (DE),A
Store the character into the destination buffer.
5180
INC DE
Advance the destination pointer.
5181
INC HL
Advance the source pointer.
5182
DJNZ 516EH
[LOOP] Decrement B and if not zero, LOOP BACK to 516EH to process the next character.
Reached end of loop (maximum characters processed) or hit invalid character.

5184
OR 01H
OR Register A with 01H to ensure NZ FLAG is set (indicating we didn't end cleanly on a delimiter).
5186
POP HL
Restore the source pointer from the stack.
5187
LD A,(HL)
Load the current character into Register A (the character that caused loop exit).
5188
RET
Return with NZ FLAG set and the terminating character in A.





Numbers below are based on LDOS 5.1 reference Manual

Errors 1-19 => $01 -> $13 - so anything above $13 is open for normal use.
typedef enum {
	FR_DISK_ERR,		1  01	/* (1) A hard error occurred in the low level disk I/O layer */
	FR_INT_ERR,		4  04	/* (2) Assertion failed */
	FR_NOT_READY,		8  08	/* (3) The physical drive cannot work */
	FR_NO_FILE,		24 18*	/* (4) Could not find the file */
	FR_NO_PATH,		24 18*	/* (5) Could not find the path */
	FR_INVALID_NAME,	19 13	/* (6) The path name format is invalid */
	FR_DENIED,		26 1A	/* (7) Access denied due to prohibited access or directory full */
	FR_EXIST,		25 19	/* (8) Access denied due to prohibited access */
	FR_INVALID_OBJECT,	16 10	/* (9) The file/directory object is invalid */
	FR_WRITE_PROTECTED,	15 0F	/* (10) The physical drive is write protected */
	FR_INVALID_DRIVE,	32 20	/* (11) The logical drive number is invalid */
	FR_NOT_ENABLED,		18 12	/* (12) The volume has no work area */
	FR_NO_FILESYSTEM,	5  05	/* (13) There is no valid FAT volume */
	FR_MKFS_ABORTED,	11 0B	/* (14) The f_mkfs() aborted due to any problem */
	FR_TIMEOUT,		3  03	/* (15) Could not get a grant to access the volume within defined period */
	FR_LOCKED,		37 25	/* (16) The operation is rejected according to the file sharing policy */
	FR_NOT_ENOUGH_CORE,	33 21	/* (17) LFN working buffer could not be allocated */
	FR_TOO_MANY_OPEN_FILES,	3F(Unknown)	/* (18) Number of open files > FF_FS_LOCK */
	FR_INVALID_PARAMETER	3F(Unknown)	/* (19) Given parameter is invalid */
} FRESULT;

BELO contains -> Mapping to possible error code to map to
specifically for API calls where specific I's migt be meaininful.

const char *FRESULT_str(FRESULT i) {
    switch (i) {
        case FR_DISK_ERR: -> 03h
            return "Error disk I/O";
        case FR_INT_ERR: -> 01h
            return "Assertion failed";
        case FR_NOT_READY:  ->
            return "Drive not ready";
        case FR_NO_FILE: -> 18h
            return "File not found";
        case FR_NO_PATH:
            return "Path not found";
        case FR_INVALID_NAME: -> 13h
            return "Path name is invalid";
        case FR_DENIED: -> 19h
            return "Access denied or full";
        case FR_EXIST: -> 19h
            return "Access denied (exists)";
        case FR_INVALID_OBJECT:
            return "The file/directory is invalid";
        case FR_WRITE_PROTECTED: -> 0Fh
            return "Write protected";
        case FR_INVALID_DRIVE:
            return "Drive number invalid";
        case FR_NOT_ENABLED: -> 23h -> 3Bh
            return "The volume has no work area";
        case FR_NO_FILESYSTEM:
            return "There is no FAT volume";
        case FR_MKFS_ABORTED:
            return "The mkfs() aborted";
        case FR_TIMEOUT:
            return "Timeout";
        case FR_LOCKED:
            return "File is locked";
        case FR_NOT_ENOUGH_CORE:
            return "LFN buffer allocation";
        case FR_TOO_MANY_OPEN_FILES:
            return "Too many open files";
        case FR_INVALID_PARAMETER:
            return "Parameter is invalid";
        default:
            return "Unknown";
    }
}




Partially existing code found in OVERLAY C

; below is copied from newdos 80 SYS 01 command parser
; https://www.trs-80.com/sub-disassem-dos-nd80-m1-sys01.htm#513DH
; HL command line Input buffer
; DE Filespec target buffer
;
FILEPARSE:
   	push	de
	ld	b,32		; max bytes
	call	CHPARSE		; parse chars
	pop	de
	ld	b,$00		; success
	ret
;
; Z Success - NZ Faliure
;
CHPARSE:
	ld	a,(hl)		; First Character
	cp	'*'		; compare with wildcard * as first character
	jr	nz,CHNORM	; not wildcard process normal
	ld	(de),a		; copy "*" it to target,
	inc	de		; next char in both buffers
	inc	hl		; next char in both buffers
	dec	b		; reduce count; fall through next char
CHNORM:
	push	hl		; save source pointer
	ld	a,(hl)		; get character (again)
	sub	'0'		; converts ASCII digits '0'-'9' to values 0-9.
	cp	10		; If carry the original char was '0'-'9'.
	call	ALPHCHECK	; check if the character is alphabetic (if not a digit). Returns CARRY if valid .
	jr	nc,INVALID	; not a valid character a-Z ; a-z ; 0-9
CHLOOP:
	ld	a,(hl)		; get character (again)
	sub	'.'		; check starting at "."
	cp	$0d		; Char between '.' and ':', incldes 0-9 and '/'
	call	ALPHCHECK
	jr	c,WASVALID	; if valid then all good
CHEND:
	ld	a,0		; end of text marker
	ld	(de),a		; put into dest buffer
	pop	af		; discard saved HL
	xor	a		; Z flag indicates success
	ret
WASVALID:
	ld	a,(hl)
	ld	(de),a
	inc	de
	inc	hl
	djnz	CHLOOP
INVALID:
	or	1		; ensure NZ flag
	pop	hl		; restore
	ld	a,(hl)		; get original char
	ret
;
; Based on Character at HL
; C Char is Valid Alphabetic character (a-z) (A-Z)
; NC was invalid
;
ALPHCHECK:
	ret	c		; if already valid then nothing to do
	ld	a,(hl)		; get char again
	sub	'A'		;
	cp	26		; compare with upper case Z
	ret	c		; if was a-Z then C so is valid
	sub	$20		; make it lower case check
	cp	26		; compare with lower case Z
	ret			; returning the C result

; Originally from TRS DOS 2.3 SYS1
; 4FF4H - Character Extraction Subroutine📋
; Reads up to B characters from the command line at (HL)
; Storing valid filename characters (digits 0-9 and uppercase letters A-Z)
; into the output buffer at (DE).
; Skips over excess characters when the maximum count is reached.
; Terminates when it encounters a 03H end-of-buffer marker,
; 0DH carriage return, or any character outside the valid range
; (below 30H or between 3AH-40H or above 5AH).
; On return: A = the character that caused termination,
; Z flag set = no valid characters were stored (first-character flag still set),
; NZ = at least one character was stored.
; Self-modifies the byte at 5026H to track whether a character has been stored in the current field.

CHREXT:				;4FF4
	LD	A,B		;Maximum character count
	LD	(MXCHAR+1),A	; Store the maximum character count into the self-modifying operand at 5026H. Self-Modifying Code
				;This writes the initial count (from B) into the operand byte of the LD A,00H instruction at 5025H. When the first valid character is stored, this value is reset to 00H at 5018H. The instruction at 5025H then reads back this byte: if non-zero, no characters have been stored yet (first-character flag); if zero, at least one character was stored.
	INC	B		; pre-increments the counter so that the DJNZ loop at 5014H will correctly count down the maximum number of characters. The actual count loop uses DEC B at 5013H followed by JR Z at 5014H.

LOOP	LD	A,(HL)		; Loop Start Fetch the next character from the command line at (HL) into Register A.
	CP	ETX		; Compare Register A against 03H (end-of-buffer terminator). If the command line buffer has been exhausted, the Z FLAG is set.
	JR	Z,TERMCH	; If the Z FLAG (Zero) has been set because the end-of-buffer terminator (03H) was reached, JUMP to 5021H to terminate character extraction and prepare the return status.
	CP	CR		; Compare Register A against 0DH (ASCII carriage return). This marks the end of the command line input.
	JR	Z,TERMCH	; If the Z FLAG (Zero) has been set because a carriage return (0DH) was reached, JUMP to 5021H to terminate character extraction.
	INC 	HL		; next character in the command line. The current character has been read into A and will be validated below. HL is advanced now so that if the character is invalid, HL already points past it.
	CP 	30H		; Compare Register A against 30H (ASCII: 0). Characters below 30H are not valid filename characters (this range includes spaces 20H, separators like "/" 2FH, and control characters).
	JR	C,TERMCH	; If the CARRY FLAG has been set because the character is less than 30H (below digit "0"), JUMP to 5021H to terminate extraction. This catches spaces, separators, and control characters.
	CP	3AH		; Compare Register A against 3AH (ASCII: :). Characters in the range 30H-39H are digits 0-9 (valid). Characters 3AH and above need further checking.
	JR	C,VALCHR	; If the CARRY FLAG has been set because the character is less than 3AH (i.e., it is a digit 0-9 in the range 30H-39H), JUMP to 5013H to store this valid character in the output buffer.
	CP 	41H		; Compare Register A against 41H (ASCII: A). Characters between 3AH-40H (colon through at-sign) are not valid filename characters.
	JR	C,TERMCH	; If the CARRY FLAG has been set because the character is between 3AH and 40H (not a digit and not a letter), JUMP to 5021H to terminate extraction. This catches the ":" drive separator (3AH) and other punctuation.
	CP	5BH		; Compare Register A against 5BH (one past ASCII: Z). Characters 41H-5AH are uppercase letters A-Z (valid). Characters 5BH and above (brackets, backslash, etc.) are not valid.
	JR	NC,TERMCH	; If the NO CARRY FLAG has been set because the character is 5BH or above (beyond 'Z'), JUMP to 5021H to terminate extraction.
;
VALCHR:
	; If we reach here, the character is a valid filename character: a digit (30H-39H) or an uppercase letter (41H-5AH).
	DEC 	B		; the remaining character counter). If B reaches zero, the maximum field length has been filled.
	JR	Z,SKIPST 	; If the Z FLAG (Zero) has been set because B reached zero (maximum characters already stored), JUMP to 501EH to skip storing this character and continue scanning past any remaining characters in the field.
	LD 	(DE),A		; Store the valid filename character from Register A into the output buffer at (DE).
	XOR	A		; Set Register A to zero. This value will be stored at 5026H to clear the "first character" flag.
	LD	(MXCHAR+1),A	; Store 00H into the self-modifying operand at 5026H. Self-Modifying Code
				; This clears the first-character flag that was set at 4FF5H. When the routine terminates, the value at 5026H is read back: 00H means at least one character was stored (success), non-zero means no characters were stored.
	INC 	DE		; Advance the output buffer pointer to the next position.
	JR	LOOP		; LOOP BACK to 4FF9H to continue reading characters from the command line. Loop End
SKIPST:	INC	B		; INCrement Register B back to 1. B was decremented to zero (field full), but the loop at 4FF9H needs B to be non-zero so DJNZ-style logic can continue scanning past excess characters without storing them.
	JR 	LOOP	; LOOP BACK to 4FF9H to continue scanning the command line. Excess characters beyond the maximum field width are consumed but not stored.
TERMCH:
	LD	C,A	; Save the terminating character from Register A into Register C. This preserves the stopping character (03H, 0DH, or a separator/invalid character) for the caller to examine.
	LD	A,EXT	; Load Register A with 03H, the buffer terminator byte.
	LD 	(DE),A	; Store the 03H terminator into the output buffer at (DE), marking the end of the extracted characters.
MXCHAR:	LD	A,0	; Self-Modifying Code The operand byte (00H shown here) is the target of the self-modifying writes at 4FF5H and 5018H. At runtime, this byte contains either the initial count (non-zero, meaning no characters were stored) or 00H (meaning at least one character was stored). The LD A instruction loads this flag value into Register A.
	OR	A	; OR Register A with itself to set the flags based on A's value. If A is 00H (characters were stored), the Z FLAG is set. If A is non-zero (no characters were stored), the NZ FLAG is set. This provides the return status to the caller.
	LD	A,C	; Restore the terminating character from Register C back into Register A. The caller can examine A to determine what character caused the extraction to stop (separator, terminator, or invalid character).
	RET		; RETURN to the caller. Z flag indicates the result: Z set = no valid characters were stored (first call yielded nothing), NZ = at least one character was stored. Register A holds the terminating character.



; MY CODE Before moved it into PicoRAM
;
	; Parse and extract the 12 character filename
	; convert the / character into .
	; only copy first 8 and 3 extension chars
	; strip out any :0 and .password
loop_start:
	ld	b,12		; max character count 8.3 filename
	ld	hl, $20 - 13	; number of chars into FCB to copy parsed filename
	add	hl,de		; add the starting DE pointer to HL, now has target
	push	hl		; pointer to start of parsed filename
loop:
	ld 	a,(de)		; get char from source filename FCB
	call	aplha_check	; check for alphanumeric
	ld 	a,(de)		; reload that char after the check
	jr	c, good_char	; if alphnumeric then proceed
	cp	'/'		; test a for / -> only other valid char
	jr	nz,finish_up	; not a / then we need to finish
	ld	a,'.'		; / needs to be converted to .
good_char:
	ld 	(hl),a		; placeing parsed filename char at end of FCB
	inc 	de		; fcb address containing source filename
	inc 	hl		; fcb address containing parsed filename
	djnz 	loop		; LOOP BACK to process the next character.
finish_up:
	inc	b		; finish by processing 1 more terminate char
	ld	a,0		; the string terminator character
padd:
	ld	(hl),a		; add string terminator to parsed string
	inc	hl		; bump the pointer
	djnz	padd		; padd until until finished
exit:
;
; This subroutine checks if the character in A is an alphabetic letter (A-Z or a-z) or 0-9
; Returns with CARRY set if the character is alphabetic. If called after a digit test fails,
; it determines if the character is a valid filename character.
; Destroys A in the process
aplha_check:
	SUB 	30H	; This converts ASCII digits '0'-'9' to values 0-9.
	CP 	0AH	; If is less than 10, the original character was a digit '0'-'9'.
	RET 	C	; If CARRY is set return immediately - character is valid.
	SUB 	11H	;Subtract 41H (ASCII 'A') from the character. This normalizes uppercase letters to 0-25.
	CP	1AH	;Compare against 1AH (26 decimal). If result is less than 26, the character was 'A'-'Z'.
	RET	C	;If CARRY is set (character is uppercase letter 'A'-'Z'), return with CARRY indicating valid.
; Not an uppercase letter - check for lowercase.
	SUB	20H	;Subtract 20H more (the difference between lowercase and uppercase in ASCII). Now checking for 'a'-'z'.
	CP	1AH	;Compare against 1AH (26). If result is less than 26, the character was 'a'-'z'.
	RET		;Return. CARRY set if lowercase letter, CARRY clear if not alphabetic.




; this was attept at documenting THE default FCB
DEF_FCB_BLK:
	DEFB	$80		; 0 Flags - $80 Open
	DEFB	$28		; 1 Flags
	DEFB	$20		; 2 Flags

	DEFB	$00		; 3 FCB Data Buffer (Passed in HL)
	DEFB	$00		; 4 FCB Data Buffer (Passed in HL)
	DEFB	$00		; 5 NEXT Low Order Byte

	DEFB	$00		; 6 Drive Number (6/7 are Filesystem ID)
	DEFB	$00		; 7 Pointer to the Files Directory Entry

	DEFB	$00		; 8 EOF Low Order Byte
	DEFB	$00		; 9 LRECL Logical Record Len (Parsed in B)
	DEFB	$00		; 10 NEXT Middle Order Byte
	DEFB	$00		; 11 NEXT High Order Byte
	DEFB	$00		; 12 EOF Middle Order Byte (from file length)
	DEFB	$00		; 13 EOF High Order Byte (from file length)
	DEFW	$FFFF		; 14 15 File Directory Extent
				; 16-31 File Directory Extent's
