; ======================================================================
;       	KDOS
;	based on TRSDOS, LDOS, and NEWDOS/80 for Model 1
;
;     Directory Management Shell Commands (multiple)
;	that act as filesystem level eg. CD, MKDIR, DEL, etc
;
;     Source Code Created By : kiwisincebirth - 2026
;     [https://github.com/kiwisincebirth/TRS-80]
;
; ======================================================================
;     NOTE: this code has been formatted with 8 spaces per tab
; ----------------------------------------------------------------------
;
import	constants.z
;
; ======================================================================
; Overlay Region (4500h - 4700h)
; ======================================================================
;
	ORG	OVERLY
	;
	ld	c,a		; c -> the command passed in.
	;
	call	enh_VER		; test if Enhanced Pico (NZ flag)
	;
	jr	nz,_DOCMD1	; Enhanced Fre Hd / Advanced Pico handling
	;
	ld	a, INTDOSERR$	; Internal Failure
	jp	@ERROR
;
_DOCMD1:
;
; Note The Command Sent to the PICO is mapped from
; the DOS Supervisor Command parameter    0 to 7
; into a matching Cmd ID in range $18 to $1F
;
	; determine the command ID to send, based on Super Call ID
	ld	a,c		; get the Supervisor ID
	rra			; translate from NNNxxxxx
	rra			; translate to   00011NNN
	rra
	rra
	rra			; rotate right -> xxxxxNNN
	and	$07		; mask the lower -> 00000NNN
	or	$18		; set bit 4/5  -> 00011NNN
	;
	; Send the Command
	out     (APICMND),A	; send the command we just mapped
				; Wait happens latter, or not at all
	;
	; determine if need to send command arguments
	ld	a,c		; the original super ID passed if
	cp	$C0		; Commands >= $C0 dont have parameters
	jr	nc,_read_result ; so skip arguments
	;
	; get length of argument string
	EX	DE, HL		; DE -> pointer to cmd buffer
	call	_STR_LEN	; and get the length (DE), into B
	;
	; send length
	ld	a,b		; size of the string
	out     (APISIZE),a	; send it to pico
	;
	; send the arguments
	EX	DE, HL		; string pointer back into HL
	ld	c,APIDATA		; data port
	otir			; write bytes from (HL) cmd buffer
	;
_read_result
	;
	; check result of the operation, either command or arguments
	call    api_WAIT	; wait for reslt
	jp      nz,@ERROR	; Command Failed
	;
	and     STATUS_DRQ	; mask DRQ status
	jr      z,_DOCMD9       ; No DRQ so done
	;
	; read the data from Pico into Buffer
	in	a,(APISIZE)	; num bytes
	ld	b,a		; count
	ld      c,APIDATA		; C from data IO Port
	ld      hl,_STR_BUFF	; to buffer
	push	hl		; save the buffer address
	inir			; transfer the data
	;
	; display any response from the command
	pop	hl		; get the start of the buffer
	call    @DSPLY
	;
_DOCMD9
	;
	JP	@EXIT		; completed so exit
;
; ----------------------------------------------------------------------
;
; Get the length of the string.
; Also in OverlayD, OverlayL, and OverlayO
;
_STR_LEN:
	push	de		; save PCB pointer
	dec	de		; dec as inc below happens first
	ld	b,0		; length including the terminator
	;
_STR_LEN1
	inc	de		; increment pointer
	inc	b		; and the counters
	ld	a,(de)		; get the byte
	cp	EXT		; end of Text terminator
	jr	z,_STR_TERM	; IF CR then end of command
	cp	ENTER		; a CR DOS terminator
	jr	z,_STR_TERM	; IF CR then end of command
	or	a		; check the byte
	jr	nz,_STR_LEN1	; NOT a ZERO terminator, so loop
	;
	pop	de		; restore the FCB
	ret			; and return the length
_STR_TERM
	xor	a
	ld 	(de),a		; replace CR with 0 terminator
	pop	de
	ret

; ----------------------------------------------------------------------

_STR_BUFF:
	; DB	'0:/SYS',0
	; storage for response strings


; ======================================================================
; 4700 - End Of Overlay
; ======================================================================
;
FREE_OVERLAYO	EQU	OVERLY + $200 - $
;
	; FILL to end of REGION
	DC	FREE_OVERLAYO , $0D
;
