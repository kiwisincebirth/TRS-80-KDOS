; ======================================================================
;       	KDOS
;	based on TRSDOS, LDOS, and NEWDOS/80 for Model 1
;
;     LOADER - Support Load and Run of CMD fies
;
;
;     Source Code Created By : kiwisincebirth - 2026
;     [https://github.com/kiwisincebirth/TRS-80]
;
; ======================================================================
;     NOTE: this code has been formatted with 8 spaces per tab
; ----------------------------------------------------------------------
;
import	constants.z
;
; ======================================================================
; Overlay Region (4500h - 4700h)
; ======================================================================
;
; todo We should ideally handle issue with loading a File to protected memory
; todo e.g. $0000 - $3000 (ROM) - which is illegal, the is a DOS error for this.
; todo Error 36 ( 24H ) - Attempt to load read only memory


	ORG	OVERLY
	;
	cp	S_LOADFILE	; WAS it a @LOAD 4430 API Call
 	jr	z,LOAD_FIL
	;
	cp	S_RUNFILE	; WAS it a @RUN  4433 API Call
 	jr	z,RUN_FIL	; called from OverlayC
	;
	cp	S_LOADCMD	; #LOAD XXXXXXXX DOS COMMAND
	jr	z,LOAD_CMD	; called from OverlayC
	;
	ld	a, INTDOSERR$	; Internal Failure
	jp	@ERROR
;
; ======================================================================
;
; DOS #LOAD Command
;
LOAD_CMD
	ld	d,h		; In the cmd processor HL points to the buffer
	ld	e,l		; In the cmd processor HL points to the buffer
	;
	call	LOAD_FIL	; call the function (with return)
	jp	nz,@ERROR	; error then the DOS ERROR exit
	;
	jp	@EXIT		; return to DOS

	;
;
; Handles 4430 - Load Program File
; On Entry
;    DE -> points to the Filespec
; On Exit
;    HL <- has the execution address
;    Z <- if load was successful
;    A <- error code, or presumably Zero
;    BC is also altered
;
LOAD_FIL
	call	_STR_LEN	; count the length of the string
	;
	call	file_loader	; attempt to load the file
	;
	ret			; (to caller) with NZ if error occurred.
				; no error. HL contains transfer address
;
; Handles 4433 - Load and Execute
;    Normally this routine is Jumped to. otherwise if called then the
;    return address will be on the stack in the target program.
; Routine will Exit by invoking the program loaded from Disk
;    If cant find program Exit to @ERROR 4409 displaying error.
; On Entry
;    DE -> points to the Filespec
; On Exit
;    HL -> pointer to command buffer (arguments)
;    AF and BC are Altered
;
RUN_FIL:
	push	hl		; save the string pointer passed in
	;
	call	_STR_LEN	; count the length of the DE string -> B
	call	file_loader	; attempt to load the file
	jr	nz,RUN_FAIL	; error handler and exit to @ERROR
	;
	; todo BUG. If the cmd file doest define a transfer address, then
	; todo HL is set based on the last load, so quite a problem
	; todo ideally it should exit to DOS @EXIT
	ex	(sp),hl		; put HL -> jump address on stack
				; and restore HL pointer passed in
	ret			; RUN the loaded program
;
RUN_FAIL:
	cp	FILNOTFND$	; was it a file not found
	jr	nz,RUN_ER2
	ld	a,PRGNOTFND$	; change to program not found
RUN_ER2:
	jp	@ERROR		; DOS ERROR
;
; Get the length of the string.
; Also in OverlayD
;
_STR_LEN:
	push	de		; save PCB pointer
	dec	de		; dec as inc below happens first
	ld	b,0		; length of the terminator
	;
_STR_LEN1
	inc	de		; increment pointer
	inc	b		; and the counters
	ld	a,(de)		; get the byte
	or	a		; check the byte
	jr	nz,_STR_LEN1	; NOT a terminator, so loop
	;
	pop	de		; restore the FCB
	ret			; and return the length
;
ifdef	@D_PICOENHANCED
;
; ON a PICo this code has to be in the SCRATCH RAM
; as keeping it in the Paged Ram (with the overlay)
; caused issues, specifically with loading code
; into he virtal ram pages themselves
file_loader	EQU	SCR_LOADOADER
;
else
;
; File loader
;
; Input:
; - DE : pointer to filename
; - B  : filename length
;
; Return:
; - HL : The Load address, execution address.
; - Z  : no error. HL contains transfer address
; - NZ : error occurred, file not or partially loaded
;
file_loader:
	ld	c,FA_OPEN_EXIST|FA_READ
	call	api_OPEN	; open file command
	ret	nz		; error, then return
	;
_load:	call	api_READBYTE	; get type code
	jr	nz,_load9	; no byte so assume finished and return
	;
	dec	a
	jr	nz,_load2	; bypass if not type 1
	;
_load1:	call	_getadr		; Type 1 get address; HL Addr and B Size
	ret	nz
	;
_load1a:
	call	api_READBYTE
	ret	nz
	ld	(hl),a		; save that byte
	inc	hl
	djnz	_load1a
	jr	_load
	;
_load2:	dec	a		; test if type 2 (TRADDR)
	jr	z,_load8		; yes consume transfer address
	;
	call	api_READBYTE	; Type 3 and above: assume comment
	ret	nz
	ld	b,a		; get comment length
_load2a:
	call	api_READBYTE	; read comment character
	ret	nz
	djnz	_load2a		; read and ignore
	jr	_load
	;
_load8:	call	_getadr		; get transfer address
	ret	nz
	;
_load9:	call	api_CLOSE
	xor	a		; set Z for success !
	ret
	;
_getadr:
	call	api_READBYTE	; get block length
	ret	nz
	ld	b,a		; get length and
	dec	b		; adjust length
	dec	b		; adjust length
	call	api_READBYTE	; get low-order load addr
	ret	nz
	ld	l,a
	call	api_READBYTE	; get high-order load addr
	ret	nz
	ld	h,a		; address into HL
	xor	a		; success
	ret
;
endif
;
; ======================================================================
; 4700 - End Of Overlay
; ======================================================================
;
FREE_OVERLAYL	EQU	OVERLY + $200 - $
;
	; FILL to end of REGION
	DC	FREE_OVERLAYL,0
;
