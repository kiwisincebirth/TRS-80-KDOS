; ======================================================================
;       	MINI DOS
;	based on TRSDOS, LDOS, and NEWDOS/80 for Model 1
;
;     COMMAND PROCESSOR
;
;     Source Code Created By : kiwisincebirth - 2026
;     [https://github.com/kiwisincebirth/TRS-80]
;
; ======================================================================
;     NOTE: this code has been formatted with 8 spaces per tab
; ----------------------------------------------------------------------
;
import	constants.z

;
; ======================================================================
; Overlay Region (4500h - 4700h)
; ======================================================================
;
	ORG	OVERLY
;
	; Continuation of Code in SYS 0 to Prompt the User and
	; Process rthe Command. follows same structure as L2 Basic
	; not the comments below indicate the original source code
	; this is done because we need to trap before tokenisation.

	; **** Print the READY message
	call	CRDONZ		;1a22 - display a carriage return if necessary
	ld	hl,m_REDDY	;1a25 - the starting address of word “READY”
	call	STROUT		;1a28 - Display the word “READY”

	; **** Prompt the User
_MAIN:	ld	hl,$FFFF	;1a33 - line number indicating Direct command mode
	ld	(CURLIN),hl	;1a36 - Set up for direct command mode - set line number
	;
	ld	a,'>'		;1a76 - READY> _ prompt
	call	OUTDO		;1a78 - Display the > Prompt
	;
	; **** Get User Command
	call	INLIN		;1a7b - Actually read a Line of input
	;
	jr	c,_MAIN		;1a7e - loop back if BREAK pressed
	;
	GETCHR			;1a81 - rst 10h
	inc	a		;1a82 - sets the status flags but saves the carry flag
	dec	a		;1a83 - so we can test for an end of statement
	jp	z,_MAIN		;1a84 - if we have an end of (or blank) statement
	push	af		;1a87 - save for latter -> 1A9D if jumping back to ROM code

	; now we need to detect the "#" symbol, and if found process locally.
	; noting first POP the Return address, the use the DOS code
	cp	CMD_PROMPT_CHR	; is it the start of a DOS command

	; Jumping Back INTO BASIC to continue
	jp	nz,READYC	; jump back into DOS READY Handler processing the BASIC Command

; ----------------------------------------------------------------------
; Processing of DOS Specific # COMMANDS starts here
; ----------------------------------------------------------------------

	pop	af		; pop AF fom above as not using it

	; hl has pointer to the command buffer noting this is a l2 BASIC (-1) pointer.
	; which is currently the '#' character
	;
	ld	(SAVBUFF),hl	; save this address for reuse
	ld	de,LOOKUPTAB	; table lookup address

	; start command lookup
_LOOK1
	; check the command with the table entry
	ld	a,(de)		; next char in lookup table
	inc	de		; bump next lookup char to check
	or	a		; flags
	jr	z,_FOUND	; found terminator in table, i.e. Found Cmd
	ld	b,a		; save lookup char for compare
	;
	RST	10h		; consume the next command char (A)
	cp	'a'		; lower case check
	jr	c,_LOOKU	; if less than `a` then skip
	sub	$20		; make lower case into uppercase
_LOOKU
	cp	b		; see if same as table char
	jr	z,_LOOK1	; yes. keep trying attempt next char
_LOOK2:
	; table entry mismatch with command
	ld	a,(de)		; examine next table char
	inc	de
	or	a		; checking the byte for 0 terminator
	jr	nz,_LOOK2	; not zero, keep skipping
	; skipped to 0 terminator
	inc	de		; then skip past the 3 byte commnad
	inc	de		;
	inc	de		;
	ld	a,(de)		; examine table Char after the address
	or	a
	jr	z,_NOTFND	; If Zero - then end of table process CMD
	; setup to check next table entry
	ld	hl,(SAVBUFF)	; restore command buffer for next attempt
	jr	_LOOK1		; check the command against next tbale entry
	;
; ----------------------------------------------------------------------
_FOUND:
	inc	hl		; consume the next command char
	ld	a,(hl)
	cp	0		; if a terminator
	jr	z,_FOUND2
	cp	' '		; is a space
	jr	nz,_LOOK2	; NOT space haven't found it
_FOUND1:
	inc	hl		; increment past the space
	ld	a,(hl)		; and check next char
	cp	' '		; is a Also a space
	jr	z,_FOUND1	; want to skip all spaces
_FOUND2:
	push	de		; JP DE : save DE pointer to stack
	ret			; ret / JUMP to the command

; ----------------------------------------------------------------------
_NOTFND:
	;
	; parse the command line string as a file name
	ld	hl,(SAVBUFF)	; get original address of command buffer
	inc	hl		; buffer pointer so actual char (not prior)
	ld	de,SYSFCB	; system FCB, where we store filename to exec
	push	de		; save system FCB for latter use
	ld	b,16		; max bytes in command name (could be 31?)
	call	_CHPARSE	; parse chars, from source to target
	jr	nz,ERROUT	; error out if NZ
	;
	push	hl		; save the buffer "arguments" after #COMMAND
	;
	; todo the following needs to be MUCH improved
	; todo TrsDOS (4FC0H) and ND80 (4F2AH) SYS1 both have good implementations
	; ensure it has cmd attached to it.
	ld	hl,DOTCMD	; copy the ".CMD" suffix
	ld	bc,5		; five bytes incl terminator
	ldir			; append to end of the file-spec
	;
	pop	hl		; pointer to buffer "arguments" to pass into command
	pop	de		; system FCB, containing name of file to run
	jp	@RUN		; $4433 - load a program file, and execute it
	;
ERROUT
	ld	a,ILLFILNAM$	; typed an illegal file name
	JP	@ERROR		; report error
;
; ----------------------------------------------------------------------
;
DOTCMD
	DEFB	'.CMD',0	; program command name terminator
;
SAVBUFF
	DW	0		; address of buffer containing command
	;
LOOKUPTAB
	; internal command lookup table, with three byte instruction
	DB	'CD',0
	SUPERV	S_CDCMD
	;
	DB	'COPY',0
	SUPERV	S_COPYCMD
	;
	DB	'CP',0
	SUPERV	S_COPYCMD
	;
	DB	'DELETE',0
	SUPERV	S_DELCMD
	;
	DB	'DEL',0
	SUPERV	S_DELCMD
	;
	DB	'DIR',0
	SUPERV	S_DIRCMD
	;
	DB	'KILL',0
	SUPERV	S_DELCMD
	;
	DB	'LOAD',0
	SUPERV	S_LOADCMD
	;
	DB	'LS',0
	SUPERV	S_DIRCMD
	;
	DB	'MKDIR',0
	SUPERV	S_MDCMD
	;
	DB	'MOVE',0
	SUPERV	S_RENCMD
	;
	DB	'MV',0
	SUPERV	S_RENCMD
	;
	DB	'PWD',0
	SUPERV	S_PWDCMD
	;
	DB	'RENAME',0
	SUPERV	S_RENCMD
	;
	DB	'REN',0
	SUPERV	S_RENCMD
	;
	DB	'RM',0
	SUPERV	S_DELCMD
	;
	; table terminator
	DB	0
;
; ----------------------------------------------------------------------
;
; Purspose pass a command string in the form
; below WAS ADAPTED (simplified) from newdos 80 SYS 01 command parser
; https://www.trs-80.com/sub-disassem-dos-nd80-m1-sys01.htm#513DH
; HL command line Input buffer
; DE Filespec target buffer
;
; Z Success - NZ Failure
;
_CHPARSE:
	ld	b,$10		; num chars to process
	push	hl		; save source pointer
_CHLOOP:
	call	_ALPHACHECK	; check if the character is alphabetic (if not a digit). Returns CARRY if valid .

	jr	c,_WASVALID	; if valid then all good

	; check for valid terminator
	ld	a,(hl)		; get character (again)
	cp	SPACE		; look for space
	jr	z,_CHENDSPC	; then end it, but if space we need to skip past all Spaces
	CP	CR		; or carriage return. This marks the end of the command line input.
	JR	Z,_CHEND
	cp	ETX		; ETX
	jr	z,_CHEND	; then end it
	;
	or	a		; check for 0 terminator
	jr	nz,_INVALID	; not a valid character a-Z ; a-z ; 0-9 or a space ternminator

_CHEND:
	pop	af		; discard saved HL
	xor	a		; Z flag indicates success, and NULL terminator
	ld	(de),a		; put into dest buffer
	ret			; Z flag Set
_CHENDSPC:
	inc	hl		; if terminator is space
	ld	a,(hl)		; inc to nexxt char
	cp	SPACE		; and if a space as well
	jr	z,_CHENDSPC	; keep skipping
	jr	_CHEND		; then finish as normal

_WASVALID:
	ld	a,(hl)
	ld	(de),a
	inc	de
	inc	hl
	djnz	_CHLOOP
				; fall thru if nmore than N chars
_INVALID:
	pop	hl		; restore saved HL pointer
	ld	a,(hl)		; get original char
	ret			; With NZ flag set
;
; Based on Character at HL
; C Char is Valid Alphabetic character (a-z) (A-Z) (0-9)
; NC was invalid
;
_ALPHACHECK:
	ld	a,(hl)		; get character (again)
	sub	$30		; '0' converts ASCII digits '0'-'9' to values 0-9.
	cp	10		; If carry the original char was '0'-'9'.
	ret	c		; if 0-9 then valid
	sub	$11		; 'A' convert to upper A
	cp	26		; compare with upper case Z
	ret	c		; if was a-Z then C so is valid
	sub	$20		; 'a' make it lower case check
	cp	26		; compare with lower case Z
	ret			; returning the C result
;
; ======================================================================
; 4700 - End Of Overlay
; ======================================================================
;
FREE_OVERLAYC	EQU	OVERLY + $200 - $
;
	; FILL to end of REGION
	DC	FREE_OVERLAYC - 1,0
	DB	$0C
;

