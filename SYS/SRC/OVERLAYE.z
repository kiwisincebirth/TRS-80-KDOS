; ======================================================================
;       	MINI DOS
;	based on TRSDOS, LDOS, and NEWDOS/80 for Model 1
;
;     ERROR HANDLING
;
;     Source Code Created By : kiwisincebirth - 2026
;     [https://github.com/kiwisincebirth/TRS-80]
;
; ======================================================================
;     NOTE: this code has been formatted with 8 spaces per tab
; ----------------------------------------------------------------------
;
import	constants.z
;
; ======================================================================
; Overlay Region (4500h - 4700h)
; ======================================================================
;
	ORG	OVERLY

; Error Code is in B - copied from A, A used by SuperV
; Bit 7 determines if the error is terminating or a CALL and return
; Bit 6 can be used to allow more information to be displayed (DOS dependant)

; TERMINATING CALL, display error, dead end routine
; JP to this routine, with bit 7 (A) = 0

; CALLABLE ERROR, display error and RETurn
; CALL to ths routine, with bit 7 (A) = 1
; All registers preserved, except F

	; test the MS bit, flag 1=return
	bit	7,b		; test the 7th bit
	jr	nz,_HANDERR	; =1 jp down, with RET out

	; otherwise if bit 7=0 then
	call	_HANDERR		; display the error
	jp	@EXIT		; JP back to DOS
;
; ----------------------------------------------------------------------
;
_HANDERR:
	push	af
	push	bc
	push	de
	push	hl
	;
;	call	enh_VER		; call the Enhanced Pico check
;	jr	nz,_ENHANCED	; enhanced handling
;
STANDARD
	res	7,b		; Bit 7 has been tested, remove bit 7
	;
	bit	6,b		; Test Bit 6 - FF Error Flag
	jp	nz,_FATFS	; if Bit 6 set then handle FF error
	;
_STD0
	res	6,b		; B now in range 0-63
	ld	hl,lookupt	; message lookup table
_STD1:
	ld	a,(hl)
	inc	hl
	or	a		; compare table terminator $00
	jr	z,_STD4		; last entry so handle generic
	cp	b		; compare with passed error
	jr	z,_STD3		; same so process it fully
_STD2
	ld	a,(hl)
	inc	hl
	cp	ETX		; is it ETX table entry terminator
	jr	nz, _STD2	; not end of table entry
	jr	_STD1		; now check next table entr
;
_STD3:
;	call	CRDONZ		; print CR if needed
	call	@DSPLY		; display the message from lookup table
	jr	_STD9		; and skip forward
;
_STD4:
;	call	CRDONZ		; print CR if needed
	ld	hl,_ERR_MSG	; "Error " message
_STD8:
	call	@DSPLY		; display it
	ld	h,0
	ld	l,b		; error into HL
	call	LINPRT		; print integer HL
_STD9:
	call	CRDO		; print a CR
_HANDX
	pop	hl		; restore the stack
	pop	de
	pop	bc
	pop	af
	ret			; return to invocation
;
; FAT FS Error in range 64-128, with a 64 offset.
_FATFS
	res	6,b		; clear bit 6 ->  0 - 63
	ld	hl,_FF_MSG	; "FF Error " message
	jr	_STD8		; and print the error
;
; ----------------------------------------------------------------------
;
_ENHANCED
	; call the enhanced function passing the Error code
	; get the response message / printing it.
	; jr	STANDARD
	; todo FUTURE this could be done with Advanced Pico call which has
	; todo a complete table of error messages, OR multiple overlays
;
; ----------------------------------------------------------------------

lookupt:
	; common errors (not all) are here
;	defb	DEVNOTAVA$ , "Device Not Available"	,ETX	; 08
	defb	WRITEPROT$ , "Write Protected Disk"	,ETX	; 15
	defb	ILLLOGFIL$ , "Illegal File Number"	,ETX	; 16
	defb	ILLFILNAM$ , "Illegal Filename"		,ETX	; 19
	defb	FILNOTFND$ , "File Not Found"		,ETX	; 24
;	defb	ACCESSDEN$ , "Access Denied"		,ETX	; 25
	defb	DIRSPCFUL$ , "Directory Space Full"	,ETX	; 26
	defb	DSCSPCFUL$ , "Disk Space Full"		,ETX	; 27
	defb	ENDOFFILE$ , "End of File Encountered"	,ETX	; 28
	defb	PRGNOTFND$ , "Program Not Found"	,ETX	; 31
	defb	ILLDRINUM$ , "Illegal Drive Number"	,ETX	; 32
	defb	LOAFILFMT$ , "Load File Format Error"	,ETX	; 34
	;
	defb	PATNOTFOU$ , "Path Not Found"		,ETX	; 60 - Path not found, like File not found
	defb	ILLDOSFUN$ , "Illegal DOS Function"	,ETX	; 61 - ND/80 for disabled functions
	defb	INTDOSERR$ , "Internal DOS Error"	,ETX	; 62 - Something that should never happen
	defb	UNKNOWN$   , "Unknown Error"		,ETX	; 63
	defb	$0

;	; TRS-80 Error messages - uncommented as necessary
;	defb	26 ,"Full or Write Protected",ETX
;
_FF_MSG:
	defb 'FatFs '		; FF Error merges into next Error
_ERR_MSG:
	defb 'Error ', ETX

; ======================================================================
; 4700 - End Of Overlay
; ======================================================================
;
FREE_OVERLAYE	EQU	OVERLY + $200 - $
;
	; FILL to end of REGION
	DC	FREE_OVERLAYE - 1,0
	DB	$0E
;
