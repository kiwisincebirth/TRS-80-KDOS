; ======================================================================
; BASIC KILL entry within the shared CMD/KILL code page
;
; Select literal-path mode for basic_command_string in BASIC-CMD.z. That
; routine evaluates the expression, rejects wildcards/whitespace and paths
; outside 1-31 characters, prefixes DEL, and calls the public DOS @CMNDI
; service. It restores its own saved state before returning to BASIC.
;
; This file is included inside the existing shared page: it does not reserve
; another page or replace any core DOS vectors. The BASIC KILL vector and
; service dispatch are defined in SYS0 and OVERLAYB respectively.
;
; Original kDOS by kiwisincebirth. Formatted with 8-column tab stops.
; ======================================================================
basic_kill:
	ld	a,1		; literal filename mode, not an arbitrary command
	jp	basic_command_string
