; ======================================================================
;       	KDOS
;	based on TRSDOS, LDOS, and NEWDOS/80 for Model 1
;
;     CONSTANTS
;
;     Source Code Created By : kiwisincebirth - 2026
;     [https://github.com/kiwisincebirth/TRS-80]
;
; ======================================================================
;     NOTE: this code has been formatted with 8 spaces per tab
; ----------------------------------------------------------------------
;
; The character used on the command prompt
CMD_PROMPT_CHR	EQU	':'
;
; ----------------------------------------------------------------------
; Z-80 Op Codes
; ----------------------------------------------------------------------
LDBCNN	EQU	$01	; LD BC,nnnn - skip 2 bytes
OPRET	EQU	$C9	; RET (Opcode)
;
; ----------------------------------------------------------------------
; Call Addresses
; ----------------------------------------------------------------------
;
; Level 2 Basic ROM Entry Addresses
;
@WHERE	EQU	$000B	; Used for Code relocation.
KBWAIT	EQU	$0049
DELAY	EQU	$0060	; delay routine
INIT2	EQU	$0075	; L2 Basic Non Disk Init
L3ERR	EQU	$012D
OUTDO	EQU	$032A
INLIN	EQU	$0361
RESETR	EQU	$06CC
LINPRT	EQU	$0FAF
CONSTR	EQU	$18F7	; address of L2 basic Math support routines
READYM	EQU	$1929	; "READY" Message
READYC	EQU	$1A88	; Continue Normal READY process loop
FINI	EQU	$1AE8
FINIDE	EQU	$1AE9
LINKER	EQU	$1AF8
SCRATH	EQU	$1B49
SCRTCH	EQU	$1B4D
RUNC	EQU	$1B5D
NEWSTT	EQU	$1D1E
FCERR	EQU	$1E4A
CRDONZ	EQU	$20F9
CRDO	EQU	$20FE
FRMEVL	EQU	$2337
STRINI	EQU	$2857
PUTNEW	EQU	$2884
STROUT	EQU	$28A7
FRESTR	EQU	$29D7
LISPRT	EQU	$2b75

;
GETCHR	macro
	rst	10h
	endm
;
;
; Pico Scratch RAM $3600 - Entry Points
;
;
SCR_LOADOADER	EQU PICOSCRATCH + 0	; entry point for Standalone Binary Loader
;
; Level 2 Basic Communications region
;
@EXIT	EQU	$402D	; Exit program normally return to DOS
@ABORT	EQU	$4030	; Abort program DONT display error message, dont continue JCL
TICKCNT	EQU	$4040	; storage location for the RTC master Tick
XTIME	EQU	$4041	; storage location for the current time and date
MEMEND	EQU	$4049	; DOS High Memory
FDIVC	EQU	$4080	; Subtraction routine used by division code...
ERRFLG	EQU	$409A	; Current Error Code. See ERR function
CURLIN	EQU	$40A2	; Current Line Number in a BASIC Program
TXTTAB	EQU	$40A4
BUFPNT	EQU	$40A7	; pointer to Keyboard Input buffer
MEMSIZ	EQU	$40B1	; Basic - MEMORY SIZE ?
AUTFLG	EQU	$40E1	; AUTO on or off flag. 0=AUTO is off.
ERRLIN	EQU	$40EA	; Line no. In which error occurred
VARTAB	EQU	$40F9
PRGFIN	EQU	$41AC	; Dos EXit for Just before BASIC's 'READY' message
;
; DOS Entry Points Routines
;
@CMD		EQU	$4400 ; Same as @EXIT
@CMNDI		EQU	$4405 ; execute command (HL), and return to DOS
@ERROR		EQU	$4409 ; Abort with AND DISPLAY error (A) message
@INIT		EQU	$4420
@OPEN		EQU	$4424
@LOAD		EQU	$4430 ; load a program file (DE)
@RUN		EQU	$4433 ; load a program file (DE), and execute it
@DSPLY		EQU     $4467
@PRINT		EQU	$446A
;
; KDOS specific data held at these Hi locations (4479-447F)
;
KBROWCLR 	EQU	$447B ; State of Clear KB Row at boot. detection of warm start ???
FHDBYTE	 	EQU	$447C ; FHD byte counter - num bytes before full READ (SYS0)
PICOVERS 	EQU	$447D ; 2 bytes Pico Version number (Startup)
DOSPRMPT	EQU	$447F ; holds CMD prompt state dos/basic (OverlayC)
;
; Jump Points into DOS Core (SYS0) routines
; must be consistent with code located at $4480
; which is a jump table to these internal routines
;
enh_VER   	equ	(0*3) + CORE2
;
api_OPEN   	equ	(1*3) + CORE2	; These routines are for the Legacy File
api_CLOSE 	equ	(2*3) + CORE2
api_READ	equ	(3*3) + CORE2
api_READBYTE	equ	(4*3) + CORE2
api_WAIT	equ	(5*3) + CORE2
;
; ======================================================================
; MAIN MEMORY MAP - LAYOUT
; Memory Locations for Regions
; ======================================================================
;

;4318H-4356H
;(63 bytes)	DOS command input buffer (TRSDOS 2.3 / T1)
;4318H. This 63-byte buffer will receive the user's keyboard input.

PICOSCRATCH	EQU	$3600		; Start of Pico Scratch RAM
PICOSCRDUSR	EQU	$37C8		; Holds Def USR 0-9 jump Addresses 20 bytes
					; 37E0 - 37EF Gap Here
PICOPAGENUM	EQU	$37F0		; Pico Virtual Page Number
;
KBDMATRX	EQU	$3800
;
CORE1		EQU	$41F8		; DOS Core Resident Code Block
SYSFCB  	EQU	$42F1		; DOS System FCB BUFFER
CORE1END	EQU	$4311		; Note there are some bytes starting 4312 debugging BREAK related
STRBUFF		EQU	$4318		; L2 Basic String Buffer (formally 41E5H)
					; requires 3 bytes preamble
					; L2 Basic Assigns $103 bytes to this buffer
;
DOSENTY 	EQU	$4400		; TRS-DOS Entry Points
CORE2		EQU	$4480		; Second Core Resident Code Block

ifdef @D_PICOENHANCED
    OVERLY	EQU	$3400		; Overlays (512 bytes) in PICO go into Paged RAM
    CORE2END	EQU	$44D0		; End of Core DOS Block 2
    DOSEND	EQU	$44D0		; Where Dos Ends. PICO -> Same as Core 2 End
    L2START 	EQU	$44D4		; Start of L2 Basic PROGRAM Storage
else
    CORE2END	EQU	$4500		; End of Core DOS Block 2
    OVERLY	EQU	$4500		; Overlays (512 bytes) go after after CORE2
    DOSEND	EQU	$4700		; Where Dos Ends. After the 512 byte overlay area
    L2START 	EQU	$4704		; Start of L2 Basic PROGRAM Storage
endif

BOOTSYSLOC	EQU	$5200		; The BOOT.SYS loader location
STARTUP		EQU	$5400		; Startup Code Block is loaded here
;
; ======================================================================
; Supervisor Call ID's
; MSB 3 bits are the function numbers ($20->1,$40->2,... $E0->7)
;    Function $00->0 is not supported, as super ID < $20 (newdos/80) are
;    handled by break key handler at 4312
; LSB 5 bits are the overlay file name ending with A-Z
; Noting the A translates to an ID of $xxx00001
; ----------------------------------------------------------------------
;
; for the time being avoid Overlay A as it conflict with BREAK KEY
BREAK_SUPERID	EQU	$01	; passed by L2 when Break Key pressed
;
SUP_OFF		EQU	'@'			;  Ascii translation Offset
;
S_BASICLOAD	EQU	'B' - SUP_OFF + $20	; LOAD basic command
S_BASICSAVE	EQU	'B' - SUP_OFF + $40	; SAVE basic command
S_BASICMERGE	EQU	'B' - SUP_OFF + $60	; MERGE basic command
S_BASICRUN	EQU	'B' - SUP_OFF + $80	; RUN  basic command
S_BASICKILL	EQU	'B' - SUP_OFF + $A0	; KILL basic command
;
S_CMDPROC	EQU	'C' - SUP_OFF + $20	; Command Interpreter READY>
S_DIRCMD	EQU	'D' - SUP_OFF + $20	; #DIR command
S_ERRHAND	EQU	'E' - SUP_OFF + $20	; (4409) DOS Error Handler
;
S_FILEEXTNT	EQU	'F' - SUP_OFF + $20	; (4473) @FEXT API Function
S_FILESPEC	EQU	'F' - SUP_OFF + $40	; (441C) @FSPEC API Function
S_INITFILE	EQU	'F' - SUP_OFF + $60	; (4420) @INIT API Function
S_OPENFILE	EQU	'F' - SUP_OFF + $80	; (4424) @OPEN API Function
S_CLOSEFILE	EQU	'F' - SUP_OFF + $A0	; (4428) @CLOSE API Function
S_KILLFILE	EQU	'F' - SUP_OFF + $C0	; (4428) @KILL API Function
;
S_READFILE	EQU	'G' - SUP_OFF + $20	; (4436) @READ API Function
S_WRITEFILE	EQU	'G' - SUP_OFF + $40	; (4439) @WRITE API Function
S_VERIFYFILE	EQU	'G' - SUP_OFF + $60	; (443C) @VER API Function
S_REWFILE	EQU	'G' - SUP_OFF + $80	; (443F) @REW API Function
S_POSNFILE	EQU	'G' - SUP_OFF + $A0	; (4442) @POSN API Function
S_BKSPFILE	EQU	'G' - SUP_OFF + $C0	; (4445) @BKSP API Function
S_PEOFFILE	EQU	'G' - SUP_OFF + $E0	; (4448) @PEOF API Function
;
S_HELPCMD	EQU	'H' - SUP_OFF + $20	; #HELP command
;
S_LOADFILE	EQU	'L' - SUP_OFF + $20	; (4430) @LOAD DOS Function
S_RUNFILE	EQU	'L' - SUP_OFF + $40	; (4433) @RUN  DOS Function
S_LOADCMD	EQU	'L' - SUP_OFF + $A0	; #LOAD command
;
S_CDCMD		EQU	'O' - SUP_OFF + $20	; #CD command
S_COPYCMD	EQU	'O' - SUP_OFF + $40	; #COPY #CP command
S_DELCMD	EQU	'O' - SUP_OFF + $60	; #DEL #DELETE #KILL #RM command
S_MDCMD		EQU	'O' - SUP_OFF + $80	; #MKDIR command
S_RENCMD	EQU	'O' - SUP_OFF + $A0	; #REN #RENAME #MV #MOVE command
S_PWDCMD	EQU	'O' - SUP_OFF + $C0	; #PWD (NO ARGS) command
;
SUPERV 	macro	p1
	ld	a,p1	; load supervisor id
	rst	28h	; call supervisor
	endm
;
; ======================================================================
;
; FCB Byte Offsets in the TRS-80 File Control Block
; ----------------------------------------------------------------------
FCB_BUFFLSB	EQU	3		; Byte 3 - Buffer Address LSB
FCB_BUFFMSB	EQU	4		; Byte 4 - Buffer Address MSB
FCB_NEXTLSB	EQU	5		; Byte 5 - Next IO Data Addr LSB
FCB_FILEID	EQU	7		; Byte 7 - FileId
FCB_LRL		EQU	9		; Byte 9 - Logical Rec Length 0=256
;
; BASIC Error Codes
; ----------------------------------------------------------------------
ERRSN		EQU	02H	; Syntax Error
;
; DOS ERROR CODES
; ----------------------------------------------------------------------
DEVNOTAVA$	EQU	08	; Device Not Available
WRITEPROT$	EQU	15	; Write Protected Disk
ILLLOGFIL$	EQU	16	; Illegal Logical File Number
ILLFILNAM$	EQU	19	; Illegal Filename
FILNOTFND$	EQU	24	; File Not Found
ACCESSDEN$	EQU	25	; Access Denied
DIRSPCFUL$	EQU	26	; Directory Space Full
DSCSPCFUL$	EQU	27	; Disk Space Full
ENDOFFILE$	EQU	28	; End of File Encountered
PRGNOTFND$	EQU	31	; Program not found
ILLDRINUM$	EQU	32	; Illegal Drive Number
LOAFILFMT$	EQU	34 	; Load file format error
;
; Error Codes 39-62 are Undefined By TrsDOS
; but valid for the TRS-80
;
PATNOTFOU$	EQU	60	; Path Not Found, (like File Not Found)
ILLDOSFUN$	EQU	61 	; Illegal (Unsupported) DOS Functon.
INTDOSERR$	EQU	62	; Internal DOS Error - Super call id issue - overlay not found - Unexpected
UNKNOWN$	EQU	63
;
; ----------------------------------------------------------------------
; ASCII
;   ASCII Codes for Keyboard and Display
; Comments (In Brackets) are the Keyboard mappings,
; ----------------------------------------------------------------------
BREAK	EQU	$01	; (BREAK Key)
ETX	EQU	$03	; End Of Text (Ascii)
;
BACKS	EQU	$08	; (LEFT  Arrow) - Backspace
TAB	EQU	$09	; (RIGHT Arrow) - Tab
LINEF	EQU	$0A	; (DOWN  Arrow)
VERTAB	EQU	$0B	; Vertical Tab (Ascii)
FORMF	EQU	$0C	; Form Feed (Ascii)
ENTER	EQU	$0D	; (ENTER Key) - Return
;
; Following are special meaning CHR codes, not ASCII standard
CURON	EQU	$0E	; turn on cursor.
CUROFF	EQU	$0F 	; turn off cursor.
TOGTAB	EQU	$15 	; (M3) toggles TAB and Alternate characters
MODE32	EQU	$17	; select line size of 32 char/line.
ARLEFT	EQU	$18	; (Shift-LEFT Arrow) backspace one character
ARIGHT	EQU	$19	; (Shift-RIGHT Arrow) skip forward one character
ARDOWN	EQU	$1A	; (Shift-DOWN Arrow) skip down one line
ARUP	EQU	$1B	; (Shift-UP  Arrow) skip up one line
CHOME	EQU	$1C	; home cursor. select 64 char/line.
CLINE	EQU	$1D	; position cursor to Start of current line
ELINE	EQU	$1E	; erase from cursor to end of line
CLRKEY	EQU	$1F	; (CLEAR Key) erase from Cursor to end of frame
;
SPACE	EQU	$20	; A space character
DQUOTE	EQU	$22	; A Double Quote ( " )
SQUOTE	EQU	$27	; A Single Quote ( ' )
SEMICO	EQU	$3B	; Note ';' in code; was breaking some assemblers
UPARRW	EQU	$5B	; (UP Arrow) Special Up Arrow ↑ Character in TRS Charset
BQUOTE	EQU	$60	; A Back Quote ( ` )
BSLASH	EQU	$5C	; A Back Slash ( \ )
;
; ======================================================================
; PICO API Definitions
; ======================================================================
;
; PICO PORT Interface defines
; ----------------------------------------------------------------------
; $C0 - $C1 HDC Write Protect and Command Registers
; $C8 - $CE HDC Data Error Sector Cylindr Registers
APIDATA	  	EQU	$C2		; 194 R/W - Primary Data Register
APISIZE     	EQU	$C3		; 195 R/W - Size of Data Register
APICMND  	EQU	$C4		; 196 WRITE ONLY - Command
APIERROR    	EQU	$C5		; 197 READ ONLY - Error
APIFILE		EQU	$C6		; 198 R/W  - File ID (new) Register
APISTAT    	EQU	$CF		; 207 READ ONLY - Status of last CMD
;
; COMMAND ID's
; ----------------------------------------------------------------------
; $00 - $0F FreHD Original Commands
GETVER		EQU	00h
;GETTIME	EQU	01h
;SETTIME	EQU	02h
OPENFILE  	EQU	03h
READFILE  	EQU	04h
WRITEFILE 	EQU	05h
CLOSEFILE	EQU	06h
OPENDIR     	EQU	08h
READDIR		EQU	09h
;
; $10 - $13 General Purpose
TRS_NEW_DIR	EQU	11h
;
; $14 - $17 File API Commands
TRS_FILE_OPEN	EQU	$14
TRS_FILE_CLOSE	EQU	$15
TRS_FILE_KILL	EQU	$16
;
; $18 - $1F Reserved for OverlayS
; They Map to the Superviser Call ID's
TRS_NEW_CD	EQU	19h
TRS_NEW_COPY	EQU	1Ah
TRS_NEW_DEL	EQU	1Bh
TRS_NEW_MD	EQU	1Ch
TRS_NEW_REN	EQU	1Dh
TRS_NEW_PWD	EQU	1Eh
;
; $20 - $27 File API Commands
TRS_FILE_READ	EQU	$20	; Read Command
TRS_FILE_WRITE	EQU	$21	; Write command
TRS_FILE_SOF	EQU	$22	; Move File Pointer - Start of File
TRS_FILE_POS	EQU	$23	; Move File Pointer - Position
TRS_FILE_BACK	EQU	$24	; Move File Pointer - Back 1 record
TRS_FILE_EOF	EQU	$25	; Move File Pointer - End of File
TRS_FILE_FCB	EQU	$26	; Get FCB for Identified File
;
; ======================================================================
; PICO API (including FATFS) attributes
; ======================================================================
;
; FatFS File Open flags
FA_READ		EQU	01h	; Data can be read from the file.
FA_WRITE        EQU	02h	; Data can be written to the file.
FA_RW		EQU	03h	; Read / Write
;
FA_OPEN_EXIST	EQU	00h	; Open existing file only. Fails if the file does NOT Exist
FA_CREATE_NEW   EQU	04h	; Creates a new file. Fails if the file DOES Exist
FA_CREATE_ALWAYS EQU	08h	; Creates a new file. Truncates, and overrites existing file.
FA_OPEN_ALWAYS  EQU	10h	; Opens a file, or creates a new file if it does not exist.
;
; FatFS Directory Attributes
AM_RDO		EQU     001H            ; Read only
AM_HID		EQU     002H            ; Hidden
AM_SYS		EQU     004H            ; System
AM_VOL		EQU     008H            ; Volume label
AM_DIR		EQU     010H            ; Directory
AM_ARC		EQU     020H            ; Archive
;
; PICO Status Bits
; ----------------------------------------------------------------------
STATUS_BUSY     EQU	0x80		; Interface is BUSY, must wait for completion
STATUS_READY    EQU	0x40		; interface is READY, to accept a new command
STATUS_WRERR    EQU	0x20		; ? Error
STATUS_SEEKDONE EQU	0x10		; ? Same as READY
STATUS_DRQ	EQU	0x08		; Indicator DATA is available.
STATUS_ZERO	EQU	0x04		; Zero Length File - Open command
STATUS_CIP	EQU	0x02		; ? Error
STATUS_ERR	EQU	0x01		; i=Indicator ERROR occurred in last operation
;
STATB_BUSY	EQU	7		; 1 = Interface is Busy
STATB_READY	EQU	6		; 1 = Interface is Ready
STATB_DRQ	EQU	3		; 1 = Data Available
STATB_ZERO	EQU	2		; 1 = Zero Length File
STATB_ERR	EQU	0		; 1 = Error
;
; NOTE: STATUS_ERR means (APIERROR) exposes the error Code
;
; ======================================================================
; MACROS
; ======================================================================
;
RET3 	macro
	RET
	RET
	RET
	endm

NOP2 	macro
	NOP
	NOP
	endm

NOP3 	macro
	NOP
	NOP
	NOP
	endm

; ======================================================================
; Memory Banking
; ======================================================================

; Bank Pages
; ----------------------------------------------------------------------

; DOS Overlays (32 of them) $00 - $1F
; Map to Page in range $E0 (224) to $FF (255)
; Which Map to entry addresses $3380 to $33FC
;
PAGE_OVERLAYA	EQU	$E1	; -unused
PAGE_OVERLAYB	EQU	$E2	; BASIC Load Save Run
PAGE_OVERLAYC	EQU	$E3	; DOS Command Shell Processor
PAGE_OVERLAYD	EQU	$E4	; #DIR Command
PAGE_OVERLAYE	EQU	$E5	; @ERROR Handling Display
PAGE_OVERLAYF	EQU	$E6	; @OPEN @INIT File Handling
PAGE_OVERLAYG	EQU	$E7	; @READ @WRITE File Handling
PAGE_OVERLAYH	EQU	$E8	; #HELP
PAGE_OVERLAYI	EQU	$E9	; -unused
PAGE_OVERLAYJ	EQU	$EA	; -unused
PAGE_OVERLAYK	EQU	$EB	; -unused
PAGE_OVERLAYL	EQU	$EC	; @LOAD @RUN CMD File
PAGE_OVERLAYM	EQU	$ED	; -unused
PAGE_OVERLAYN	EQU	$EE	; -unused
PAGE_OVERLAYO	EQU	$EF	; #CD #MD #REN #DEL Commands

; Basic Extensions & other Misc Pages (32)
; Pages - C0 (192) to DF (223)
;
PAGE_INTERRUPT	EQU	193	; Interrupt Service Routing
PAGE_KEYBDRV	EQU	194	; (Optional) Keyboard Driver
PAGE_BASICHELP	EQU	195	; Text for HELP command (Basic)
;
PAGE_AMPERSAND	EQU	207
PAGE_CVI	EQU	208
PAGE_CVS	EQU	209
PAGE_CVD	EQU	210
PAGE_DOSERROR1	EQU	211
PAGE_DOSERROR2	EQU	212
PAGE_DEFINE	EQU	213
PAGE_DEFINEFN	EQU	214
PAGE_INSTRFUNC	EQU	215
PAGE_LINEINP	EQU	216
PAGE_MIDOLLAR	EQU	217
PAGE_MKI	EQU	218
PAGE_MKS	EQU	219
PAGE_MKD	EQU	220
PAGE_TIMEDOLL	EQU	221
PAGE_USRN	EQU	222

; BANK PAGING MACROS
; ----------------------------------------------------------------------

; Callable Routine that Returns
VIRTUAL_ROUTINE macro label, pagenum
	assert pagenum>=0 && pagenum<$100	; Parameter validation
	ORG  	$3000 + (pagenum * 4)		; Trampoline address
label	EQU	$		; Define a program label for Entry
	DEFB 	$CD		; Write CALL opcode to Offset $0
	ORG  	$3400		; All code sits in the 512-byte window
endm

; NON Returning routine, just JUMP into it
VIRTUAL_PAGE macro label, pagenum
	assert pagenum>=0 && pagenum<$100	; Parameter validation
	ORG  	$3000 + (pagenum * 4)		; Trampoline address
label	EQU	$		; Define a program label for Entry
	DEFB 	$C3		; Write JP opcode to Offset $0
	ORG  	$3400		; All code sits in the 512-byte window
endm

VIRTUAL_END macro
	assert $ <= $3600
endm

; Call routine in Page
PAGE_CALL macro pagenum
	assert pagenum>=0 && pagenum<$100	; Parameter validation
	CALL  	$3000 + (pagenum * 4)		; Trampoline address
endm

; Jump to routine in Page
PAGE_JP macro pagenum
	assert pagenum>=0 && pagenum<$100	; Parameter validation
	JP  	$3000 + (pagenum * 4)		; Trampoline address
endm
