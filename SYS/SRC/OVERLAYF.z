; ======================================================================
;       	MINI DOS
;	based on TRSDOS, LDOS, and NEWDOS/80 for Model 1
;
;     FILE HANDLING FOR DOS API's @ $4400 - $4480
;	Deals with Lifecycle of File Object
;	( See Overlay G for the R/W access functions )
;
;     Source Code Created By : kiwisincebirth - 2026
;     [https://github.com/kiwisincebirth/TRS-80]
;
; ======================================================================
;     NOTE: this code has been formatted with 8 spaces per tab
; ----------------------------------------------------------------------
;
import	constants.z
;
; ======================================================================
; Overlay Region (4500h - 4700h)
; ======================================================================
;
	ORG	OVERLY

	push	af		; preserve the Super Call ID
	call	enh_VER		; test if Enhanced Pico (NZ flag)
	jr	z,_NOT_ENH	; Enhanced Fre Hd / Advanced Pico handling
	pop	af
	;
	cp	S_FILESPEC	; (441C) @FSPEC API Function
	jp	z,_filespec
	;
	cp	S_INITFILE	; (4420) @INIT API Function
 	jp	z,_init_open
 	;
	cp	S_OPENFILE	; (4424) @OPEN API Function
 	jp	z,_init_open	; same function as INIT, it checks.
 	;
 	cp	S_CLOSEFILE	; (4428) @CLOSE API Function
 	jp	z,_closefile
 	;
 	cp	S_KILLFILE	; (4428) @KILL API Function
 	jp	z,_killfile
 	;
	ld	a, INTDOSERR$	; Internal Failure
	jp	@ERROR

_NOT_ENH
	pop	af
_ILLEGAL
	ld	a, ILLDOSFUN$	; (NOT enhanced) so illegal Dos Function
	or	a		; set the flags
	ret			; return failure

;
; @FSPEC API Function (441C)
;
; DE -> Pointer to FCB 32 byte Buffer.
; HL -> Pointer to string containing the input filename
; Ret Z - No Error ; NZ - Error (A DOES'NT contain error)
; BC is destroyed
; DE <- Unchanged, pointer to FCB
; HL <- Terminating character in the Buffer
; A <- terminating character
;
_filespec
	push	de
	; todo
	pop	de
	JP	_ILLEGAL
	ret

;
; @INIT New or Open Existing File ($4420)
; B - Logical Record Length (0=256)
; DE - Pointer to FCB 32 byte Buffer, containing filename
; HL - Pointer to 256 byte IO Buffer
; Ret Z - No Error ; NZ - Error (A error Code)
; B DE HL Registers Intact
;
; @OPEN Existing File ($4424)
; B - Logical Record Length (0=256)
; DE - Pointer to FCB 32 byte Buffer, containing filename
; HL - Pointer to 256 byte IO Buffer
; Ret Z - No Error ; NZ - Error (A error Code)
; If the file doesnt exist then this is an ERROR
; B DE HL Registers Intact
;
_init_open:
	push	hl	; save the buffer pointer
	push	bc	; save the LRL
	push	de	; save the FCB
	push	af	; save the super ID
;
	; setup the file open command
	ld	a,TRS_FILE_OPEN		; API FILE OPEN command
	out	(COMMAND2),a		; send command to frehd
;
 	; byte 0 : open options
	pop	af			; get the Super ID back
	cp	S_INITFILE		; Open Existing or Create New
	ld	a,FA_OPEN_EXIST|FA_RW	; Default to Open Existing file @OPEN
	jr	nz, _open_skip1		; skip IF NOT an INIT, is OPEN
	ld	a,FA_OPEN_ALWAYS|FA_RW	; Open Existing or Create a new @INIT
_open_skip1
	ld	c,DATA2			; the data port
	out	(c),a			; send it.
;
 	; byte 1 : logical record lenght 0=256 (B)
 	out	(c),b
 	; byte 2,3 : location of Buffer in TRS memory (DE)
 	out	(c),e
 	out	(c),d
 	; bytes 4..36 : fcb data from TRS (HL)
	ld	b,$20			; b=0 "256" bytes
	ex	de,hl			; swap FCB into HL
	otir				; send data from (hl) to port (C)
;
_open_open:
	call	fhd_WAIT		; wait for status of OPEN
	jr	nz,_open_out1		; error then out of here
;
	pop	hl			; pop the FCB address
	push	hl			; saving it back
	ld	b,$20			; FCB is 32 bytes
	inir				; transfer the data back to HL
;
	xor	a			; success
;
_open_out1:
	pop	de			; restore the pointers
	pop	bc
	pop	hl
	ret				; and return
;
; @CLOSE Close an Open File ($4428)
; Closes existing file writing any dirty data back to disk
;
; If bit 4 of the FCB's 2nd byte equals 1, the FCB's buffer is written to disk like a 4439H call.
; If the file has excess data beyond EOF and if automatic space deallocation is allowed, fle is truncated
;
; DE -> Pointer to FCB 32 byte Buffer
; Ret Z - No Error ; NZ - Error (A error Code)
; FCB now contain the original full file name.
;
_closefile
	; todo
	; Send the Command
	; Send the 16 byte FCB
	; Wait
	; Return if any Error
	; Receive the 32 byte FCB
	; Return
	JP	_ILLEGAL

;
; @KILL Kill FCB's associated file. ($442C)
; If a file is to be killed, the FCB must be in an open condition.
; DE -> Pointer to FCB 32 byte Buffer
; Ret Z - No Error ; NZ - Error (A error Code)
; The original Filename placed back in the FCB (LDOS)
; The FCB is set to all zero's (NewDos80)
;
_killfile
	; todo
	; Send the Command
	; Send the 16 byte FCB
	; Wait
	; Return if any Error
	; Receive the 32 byte FCB
	; Return
	JP	_ILLEGAL

;
; ======================================================================
; 4700 - End Of Overlay
; ======================================================================
;
FREE_OVERLAYF	EQU	OVERLY + $200 - $
;
	; FILL to end of REGION
	DC	FREE_OVERLAYF - 1,0
	DB	$0F
;

; OPEN
; * Send the 32 byte FCB block to PICO, OPEN command
; * PICO
;   * extracts the parameters
;   * Parses the FIlename
;   * Opens the FIle
;   * Return Block  0-31 - As defined
; * PICO ALternate
;   Pass filemode, and parsed filename, responds with EOF, and File 16 bit ID
; * Receive back 32 bytes which override the existing FCB
; * Return

; Other Operations
;   Pass the 16bit File Identifier,
;   For Read need to pass the LRL
;   Always respond with the 16 byte updated FCB
;   For reads the LRL data follows this.

; BEFORE CALL to DOS
; 48 49 53 43  4F 52 45 53  2F 4D 45 54  3A 30 0D 4D |HISCORES/MET:0.M|
; 45 54 45 4F  52 20 4D 49  53 53 49 4F  4E 20 49 49 |ETEOR MISSION II|

; $B277 - Calls Open File 4420

; LDOS - Open Existing File
; 80 20 00 00  73 00 00 0B  00 00 00 00  01 00 0F 40 |. ..s..........@|
; FF FF FF FF  FF FF FF FF  FF FF FF FF  FF FF FF FF |................|

; NEWDOS/80 - Open Existing File
; 80 28 20 00  73 00 00 1B  00 00 00 00  01 00 09 60 |.( .s..........`|
; FF FF FF FF  FF FF FF FF  FF FF FF FF  FF FF FF FF |................|

; 80 28 20 00  73 00 00 1B  00 00 00 00  01 00 09 60 |.( .s..........`|
; FF FF FF 48  49 53 43 4F  52 45 53 2F  4D 45 54 00 |...HISCORES.MET.|

; M1ZVM
; =====

;@FSPEC	EQU	441CH	;4EH
;@INIT	EQU	4420H	;3AH in progress
;@OPEN	EQU	4424H	;3BH in progress
;@CLOSE	EQU	4428H	;3CH

;@READ	EQU	4436H	;43H	;Read a file record
;@WRITE	EQU	4439H	;4BH	;Write a file record
;@VER	EQU	$443c   ; (METEOR MISSION)

;@REW	EQU	443FH	; This SVC will rewind a file to its beginning and reset the 3-byte NRN pointer to 0.
;@POSN	EQU	4442H	; Position file to record BC

