; ======================================================================
;       	KDOS
;	based on TRSDOS, LDOS, and NEWDOS/80 for Model 1
;
;     FILE HANDLING FOR DOS API's @ $4400 - $4480
;	Deals with Lifecycle of File Object
;	( See Overlay G for the R/W access functions )
;
;     Source Code Created By : kiwisincebirth - 2026
;     [https://github.com/kiwisincebirth/TRS-80]
;
; ======================================================================
;     NOTE: this code has been formatted with 8 spaces per tab
; ----------------------------------------------------------------------
;
import	constants.z
;
; ======================================================================
; Overlay Region (4500h - 4700h)
; ======================================================================
;
	ORG	OVERLY
	;
	; First Test Normal
	;
	cp	S_FILESPEC	; (441C) @FSPEC API Function
	jp	z,_fspec
	;
	cp	S_FILEEXTNT	; (4473) @FEXT API Function
	jp	z,_fext
	;
	; ENHANCED
	;
	push	af		; preserve the Super Call ID
	call	enh_VER		; test if Enhanced Pico (NZ flag)
	jr	z,_NOT_ENH	; Only works on Enhanced - Escape Out
	pop	af
	;
	cp	S_INITFILE	; (4420) @INIT API Function
 	jp	z,_init_open
 	;
	cp	S_OPENFILE	; (4424) @OPEN API Function
 	jp	z,_init_open	; same function as INIT, it checks.
 	;
 	cp	S_CLOSEFILE	; (4428) @CLOSE API Function
 	jp	z,_closefile
 	;
 	cp	S_KILLFILE	; (4428) @KILL API Function
 	jp	z,_killfile
 	;
	ld	a, INTDOSERR$	; Internal Failure
	jp	@ERROR

_NOT_ENH
	pop	af
_ILLEGAL
	ld	a, ILLDOSFUN$	; (NOT enhanced) so illegal Dos Function
	or	a		; set the flags
	ret			; return failure
;
; ======================================================================
;
; @FEXT API Function (4473)
;
; DE -> Pointer to FCB 32 byte Buffer.
; HL -> Pointer to default extension, 3 chars
; BC is destroyed
; DE <- Unchanged, pointer to FCB
; HL <- Unchanged

; below is copied from trs dos SYS 01
; https://www.trs-80.com/sub-disassem-dos-td23-sys-1.htm
; todo this might need work, e.g. FILE.EXT might become -> FILE.EXT/EXT

_fext
	push	de                   ; 4fc0:
	push	hl                   ; 4fc1:
	ex	de,hl                ; 4fc2:
	inc	hl                   ; 4fc3:
	ld	b,$09                ; 4fc4:
_4fc6:
	ld	a,(hl)               ; 4fc6:
	cp	$2f                  ; 4fc7:
	jr	z,_4fd8              ; 4fc9:
	jr	c,_4fdb              ; 4fcb:
	cp	$3a                  ; 4fcd:
	jr	c,_4fd5              ; 4fcf:
	cp	$41                  ; 4fd1:
	jr	c,_4fdb              ; 4fd3:
_4fd5:
	inc	hl                   ; 4fd5:
	djnz	_4fc6                ; 4fd6:
_4fd8:
	pop	hl                   ; 4fd8:
	pop	de                   ; 4fd9:
	ret                          ; 4fda:
_4fdb:
	ld	bc,$000f             ; 4fdb:
	add	hl,bc                ; 4fde:
	ld	d,h                  ; 4fdf:
	ld	e,l                  ; 4fe0:
	inc	de                   ; 4fe1:
	inc	de                   ; 4fe2:
	inc	de                   ; 4fe3:
	inc	de                   ; 4fe4:
	inc	bc                   ; 4fe5:
	lddr                         ; 4fe6:
	pop	hl                   ; 4fe8:
	inc	hl                   ; 4fe9:
	inc	hl                   ; 4fea:
	ld	c,$03                ; 4feb:
	lddr                         ; 4fed:
	ld	a,$2f                ; 4fef:
	ld	(de),a               ; 4ff1:
	pop	de                   ; 4ff2:
	ret                          ; 4ff3:

;
; @FSPEC API Function (441C)
;
; DE -> Pointer to FCB 32 byte Buffer.
; HL -> Pointer to string containing the input filename
; Ret Z - No Error ; NZ - Error (A DOES'NT contain error)
; BC is destroyed
; DE <- Unchanged, pointer to FCB
; HL <- Terminating character in the Buffer
; A <- terminating character
;
; below is copied from newdos 80 SYS 01 command parser
; https://www.trs-80.com/sub-disassem-dos-nd80-m1-sys01.htm#513DH
;
_fspec
	call	_5150           ; 513d:
	push	af              ; 5140:
	ld	a,(hl)          ; 5141:
	sub	$03             ; 5142:
	jr	z,_5148         ; 5144:
	sub	$0a             ; 5146:
_5148
	jr	z,_514b         ; 5148:
	inc	hl              ; 514a:
_514b
	pop	af              ; 514b:
	ret                  	; 514c:
_5150:
   	push	de
	ld	b,32		; max bytes
	call	_515A		; parse chars
	pop	de
	ld	b,$00		; success
	ret
;
; Z Success - NZ Faliure
;
_515A:
	ld	a,(hl)		; First Character
	cp	'*'		; compare with wildcard * as first character
	jr	nz,_5163	; not wildcard process normal
	ld	(de),a		; copy "*" it to target,
	inc	de		; next char in both buffers
	inc	hl		; next char in both buffers
	dec	b		; reduce count; fall through next char
_5163:
	push	hl		; save source pointer
	ld	a,(hl)		; get character (again)
	sub	'0'		; converts ASCII digits '0'-'9' to values 0-9.
	cp	10		; If carry the original char was '0'-'9'.
	call	_5189		; check if the character is alphabetic (if not a digit). Returns CARRY if valid .
	jr	nc,_5184	; not a valid character a-Z ; a-z ; 0-9
_516e:
	ld	a,(hl)		; get character (again)
	sub	'.'		; check starting at "."
	cp	$0d		; Char between '.' and ':', incldes 0-9 and '/'
	call	_5189
	jr	c,_517E		; if valid then all good
_5178:
	ld	a,3		; end of text marker
	ld	(de),a		; put into dest buffer
	pop	af		; discard saved HL
	xor	a		; Z flag indicates success
	ret
_517E:
	ld	a,(hl)
	ld	(de),a
	inc	de
	inc	hl
	djnz	_516e
_5184:
	or	1		; ensure NZ flag
	pop	hl		; restore
	ld	a,(hl)		; get original char
	ret
;
; Based on Character at HL
; C Char is Valid Alphabetic character (a-z) (A-Z)
; NC was invalid
;
_5189:
	ret	c		; if already valid then nothing to do
	ld	a,(hl)		; get char again
	sub	'A'		;
	cp	26		; compare with upper case Z
	ret	c		; if was a-Z then C so is valid
	sub	$20		; make it lower case check
	cp	26		; compare with lower case Z
	ret			; returning the C result

;
; @INIT New or Open Existing File ($4420)
; B - Logical Record Length (0=256)
; DE - Pointer to FCB 32 byte Buffer, containing filename
; HL - Pointer to 256 byte IO Buffer
; Ret Z - No Error ; NZ - Error (A error Code)
; B DE HL Registers Intact
;
; @OPEN Existing File ($4424)
; B - Logical Record Length (0=256)
; DE - Pointer to FCB 32 byte Buffer, containing filename
; HL - Pointer to 256 byte IO Buffer
; Ret Z - No Error ; NZ - Error (A error Code)
; If the file doesnt exist then this is an ERROR
; B DE HL Registers Intact
;
_init_open:
	push	hl	; save the buffer pointer
	push	bc	; save the LRL
	push	de	; save the FCB
	push	af	; save the super ID
;
	; setup the file open command
	ld	a,TRS_FILE_OPEN		; API FILE OPEN command
	out	(APICMND),a		; send command to Pico
;
 	; byte 0 : open options
	pop	af			; get the Super ID back
	cp	S_INITFILE		; Open Existing or Create New
	ld	a,FA_OPEN_EXIST|FA_RW	; Default to Open Existing file @OPEN
	jr	nz, _open_skip1		; skip IF NOT an INIT, is OPEN
	ld	a,FA_OPEN_ALWAYS|FA_RW	; Open Existing or Create a new @INIT
;
_open_skip1
	; byte 0 : open options
	ld	c,APIDATA			; the data port
	out	(c),a			; send it.
 	; byte 1 : logical record length 0=256 (B)
 	out	(c),b
 	; byte 2,3 : location of Buffer in TRS memory (HL)
 	out	(c),l
 	out	(c),h
 	; bytes 4..36 : fcb data from TRS (HL)
	ld	b,$20			; b=0 "256" bytes
	ex	de,hl			; swap FCB into HL
	otir				; send data from (hl) to port (C)
;
_open_open:
	call	api_WAIT		; wait for status of OPEN
	jr	nz,_open_out1		; error then out of here
;
	; copy the FCB data back to ram.
	pop	hl			; pop the FCB address
	push	hl			; saving it back
	ld	b,32			; FCB is 32 bytes
	inir				; transfer the data back to HL
;
	BIT	STATB_ZERO, A		; check status (from api_wait) for FileLen = 0
	JR	NZ, _new_file		; If Zero length (flag) then => New file
_existing_file:
    	XOR	A                	; set Zero flag (Success),
	jr	_open_out1		; CLEAR CARRY = Existing File
_new_file:
	XOR	A                	; set Zero flag (Success)
	SCF                     	; SET CARRY = New File Created
;
_open_out1:
	pop	de			; restore the pointers
	pop	bc
	pop	hl
	ret				; and return
;
; @CLOSE Close an Open File ($4428)
; Closes existing file writing any dirty data back to disk
;
; If bit 4 of the FCB's 2nd byte equals 1, the FCB's buffer is written to disk like a 4439H call.
; If the file has excess data beyond EOF and if automatic space deallocation is allowed, fle is truncated
;
; DE -> Pointer to FCB 32 byte Buffer
; Ret Z - No Error ; NZ - Error (A error Code)
; FCB now contain the original full file name.
;
_closefile
	push	de
	pop	ix			; get fcb into IX
	ld	a,(ix+FCB_FILEID)	; file id from the FCB
	out	(APIFILE),a		; write file id to pico
	;
	ld	a,TRS_FILE_CLOSE	; close command
	out	(APICMND),a		; send the command
	;
	call	api_WAIT		; wait for status

	; copy the FCB data back overiting the FCB
	ld	h,d			; copy fcb into HL
	ld	l,e
	ld	bc,$2000+APIDATA		; copy B=$20 bytes from Port C=DATA
	inir				; transfer the data back to HL

	ret
;
; @KILL Kill FCB's associated file. ($442C)
; If a file is to be killed, the FCB must be in an open condition.
; DE -> Pointer to FCB 32 byte Buffer
; Ret Z - No Error ; NZ - Error (A error Code)
; The original Filename placed back in the FCB (LDOS)
; The FCB is set to all zero's (NewDos80)
; The FCB is set to the original filename (LDOS)
;
_killfile
	; todo
	; Send the Command
	; Send the 16 byte FCB
	; Wait
	; Return if any Error
	; Receive the 32 byte FCB
	; Return
	JP	_ILLEGAL

;
; ======================================================================
; 4700 - End Of Overlay
; ======================================================================
;
FREE_OVERLAYF	EQU	OVERLY + $200 - $
;
	; FILL to end of REGION
	DC	FREE_OVERLAYF - 1,0
	DB	$0F
;

